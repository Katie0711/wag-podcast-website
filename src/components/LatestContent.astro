---
// Behavior-first "don't miss what's next" module -- deliberately has no
// eyebrow/section label (e.g. "Just Dropped"/"Now Playing"). The real
// content itself (image + title) is the hero; a manufactured label was
// tested and cut. Purely presentational: every real value (image, title,
// date, hrefs) is resolved by the calling page from its own content
// collection, so this component has zero knowledge of "episodes" vs
// "videos" and can be reused anywhere a "latest real thing" moment is
// needed (see placement notes in the page that imports this).
import EqBars from "./EqBars.astro";

interface SupportPlatform {
  icon: "spotify" | "apple";
  line: string;
  sub: string;
  href: string;
}

interface Props {
  image: string;
  // A guaranteed-to-exist thumbnail (e.g. hqdefault) to swap to client-side
  // if `image` 404s -- YouTube doesn't generate a maxresdefault for every
  // upload and returns a real 404 for it when missing, unlike the smaller
  // sizes, so this has to be handled explicitly.
  imageFallback?: string;
  imageAlt: string;
  itemTitle: string;
  itemHref: string;
  date: Date;
  headline: string;
  primaryLine: string;
  primaryHref: string;
  primaryCtaLabel?: string;
  support?: SupportPlatform[];
  proofLine?: string;
}

const {
  image, imageFallback, imageAlt, itemTitle, itemHref, date, headline,
  primaryLine, primaryHref, primaryCtaLabel = "Never Miss the Next One →",
  support = [], proofLine,
} = Astro.props;

const dateLabel = new Intl.DateTimeFormat("en-US", { month: "short", day: "numeric" }).format(date);

const icons: Record<SupportPlatform["icon"], string> = {
  spotify: `<circle cx="12" cy="12" r="10" fill="none"/><path d="M6 9.5c3.5-1 8-.6 11 1M6.5 13c3-1 6.5-.7 9 .8M7 16.3c2.4-.7 5-.5 7.2.7" stroke="#fff" stroke-width="1.8" fill="none" stroke-linecap="round"/>`,
  apple: `<path d="M12 3a9 9 0 0 0-9 9v6a2 2 0 0 0 2 2h1v-8H4a8 8 0 0 1 16 0h-2v8h1a2 2 0 0 0 2-2v-6a9 9 0 0 0-9-9z"/>`,
};
---

<section class="lc" data-reveal>
  <div class="container lc-grid">
    <a class="lc-media" href={itemHref}>
      <img
        src={image}
        alt={imageAlt}
        loading="eager"
        fetchpriority="high"
        onerror={imageFallback ? `this.onerror=null;this.src='${imageFallback}'` : undefined}
      />
      <span class="lc-play" aria-hidden="true">▶</span>
      <div class="lc-media-cap">
        <span class="lc-media-title">{itemTitle}</span>
        <span class="lc-media-meta"><EqBars size="sm" /> {dateLabel}</span>
      </div>
    </a>

    <div class="lc-right">
      <h2 class="lc-headline">{headline}</h2>

      <div class="lc-primary">
        <p class="lc-primary-line">{primaryLine}</p>
        <a class="lc-primary-btn" href={primaryHref} target="_blank" rel="noopener">{primaryCtaLabel}</a>
      </div>

      {support.length > 0 && (
        <div class="lc-support">
          {support.map((s) => (
            <a class={`lc-support-card icon-${s.icon}`} href={s.href} target="_blank" rel="noopener">
              <span class="lc-support-icon" set:html={icons[s.icon]} />
              <span class="lc-support-copy">
                <b>{s.line}</b>
                <span>{s.sub}</span>
              </span>
            </a>
          ))}
        </div>
      )}

      {proofLine && <p class="lc-proof">{proofLine}</p>}
    </div>
  </div>
</section>

<style>
  .lc{ padding: 0 0 64px; }
  .lc-grid{ display:grid; grid-template-columns: 1.15fr 1fr; gap:40px; align-items:center; }

  .lc-media{
    position:relative; display:block; border-radius: var(--radius-lg); overflow:hidden;
    aspect-ratio: 16/9; background:#0d0d12; box-shadow: 0 30px 60px -28px rgba(0,0,0,.55);
  }
  .lc-media img{ position:absolute; inset:0; width:100%; height:100%; object-fit:cover; transition: transform .3s ease; }
  .lc-media:hover img{ transform: scale(1.03); }
  .lc-media::after{
    content:""; position:absolute; inset:0;
    background: linear-gradient(0deg, rgba(10,10,15,.92) 0%, rgba(10,10,15,.1) 55%, transparent 75%);
  }
  .lc-play{
    position:absolute; top:50%; left:50%; transform:translate(-50%,-50%);
    width:60px; height:60px; border-radius:50%; background:rgba(10,10,15,.55);
    border:2px solid rgba(255,255,255,.85); display:flex; align-items:center; justify-content:center;
    color:#fff; font-size:1.05rem; z-index:1; transition: transform .2s ease, background .2s ease;
  }
  .lc-media:hover .lc-play{ background: var(--wag-pink); transform: translate(-50%,-50%) scale(1.08); }
  .lc-media-cap{ position:absolute; left:0; right:0; bottom:0; z-index:1; padding:20px 22px; display:flex; flex-direction:column; gap:6px; }
  .lc-media-title{ font-family: var(--font-display); font-weight:700; text-transform:none; letter-spacing:0; font-size:1.2rem; color:#fff; line-height:1.2; }
  .lc-media-meta{ display:flex; align-items:center; gap:8px; font-family: var(--font-display); text-transform:uppercase; letter-spacing:.05em; font-size:.72rem; color: var(--wag-green); font-weight:700; }

  .lc-headline{
    font-family: var(--font-display); text-transform:uppercase; font-weight:800;
    font-size: clamp(1.6rem, 3vw, 2.3rem); line-height:1.05; margin:0 0 20px; max-width:16ch;
  }

  .lc-primary{
    background: linear-gradient(135deg, rgba(255,22,200,.1), rgba(10,10,15,0));
    border:1.5px solid var(--wag-pink); border-radius: var(--radius); padding:22px 24px;
    display:flex; flex-direction:column; gap:14px; margin-bottom:16px;
  }
  .lc-primary-line{ font-family: var(--font-display); font-weight:700; font-size:1.15rem; margin:0; color:#fff; line-height:1.2; }
  .lc-primary-btn{
    align-self:flex-start; display:inline-flex; align-items:center; gap:8px;
    background: var(--wag-pink); color:#fff; font-family: var(--font-display); text-transform:uppercase;
    font-weight:700; letter-spacing:.03em; font-size:.9rem; padding:12px 20px; border-radius:9px;
    box-shadow: 0 14px 28px rgba(255,22,200,.28); transition: transform .15s ease, box-shadow .15s ease;
  }
  .lc-primary-btn:hover{ transform: translateY(-2px); box-shadow: 0 18px 34px rgba(255,22,200,.36); }

  .lc-support{ display:flex; flex-direction:column; gap:10px; margin-bottom:16px; }
  .lc-support-card{
    display:flex; align-items:center; gap:12px; padding:13px 16px;
    border-radius:10px; border:1px solid var(--line); background: var(--bg-alt);
    transition: border-color .15s ease, transform .15s ease;
  }
  .lc-support-card:hover{ transform: translateX(2px); }
  .icon-spotify:hover{ border-color:#1DB954; }
  .icon-apple:hover{ border-color:#F452FF; }
  .lc-support-icon{
    width:30px; height:30px; border-radius:8px; flex:none;
    display:flex; align-items:center; justify-content:center;
  }
  .lc-support-icon :global(svg){ width:15px; height:15px; fill:#fff; }
  .icon-spotify .lc-support-icon{ background:#1DB954; }
  .icon-apple .lc-support-icon{ background: linear-gradient(135deg,#F452FF,#832BC1); }
  .lc-support-copy{ display:flex; flex-direction:column; gap:1px; }
  .lc-support-copy b{ font-family: var(--font-display); font-weight:700; text-transform:none; letter-spacing:0; font-size:.9rem; color: var(--ink); }
  .lc-support-copy span{ font-size:.76rem; color: var(--ink-muted); }

  .lc-proof{ font-size:.82rem; color: var(--ink-muted); margin:0; }

  @media (max-width: 860px){
    .lc-grid{ grid-template-columns:1fr; gap:26px; }
    .lc-headline{ max-width:none; }
  }
</style>
