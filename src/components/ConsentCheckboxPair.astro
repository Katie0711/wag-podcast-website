---
// Reusable split-consent capture: two independent, unchecked-by-default
// checkboxes, never one implying the other. Checking either one requires
// an email and calls /api/verdict-consent, which creates a real Beehiiv
// subscription and applies only the tags for the box(es) actually
// checked -- checking the first box alone never adds anyone to general
// WAG Insider marketing. Built once here; any future interaction that
// needs the same transactional/marketing split reuses this component
// rather than rebuilding it.
interface Props {
  voteKey: string; // the item this consent capture is attached to (a Verdict voteKey, a quizKey, etc.)
  transactionalLabel: string;
  marketingLabel: string;
  // Everything below defaults to Verdict's original, already-verified
  // behavior -- only a new caller (e.g. WAG Match) needs to set these.
  apiEndpoint?: string;
  transactionalTag?: string; // required by /api/interaction-consent; ignored by /api/verdict-consent
  revealEvent?: string; // custom event that reveals this form once the interaction is complete
  storageKey?: string; // localStorage key checked on load so a return visitor sees the form immediately
}
const {
  voteKey,
  transactionalLabel = "Email me when this Verdict is revealed",
  marketingLabel = "Also join WAG Insider for future votes, quizzes, episodes, and product news",
  apiEndpoint = "/api/verdict-consent",
  transactionalTag,
  revealEvent = "wag:voted",
  storageKey = `wag_voted_${voteKey}`,
} = Astro.props;
---

<div
  class="consent-pair"
  data-consent-pair
  data-vote-key={voteKey}
  data-api-endpoint={apiEndpoint}
  data-transactional-tag={transactionalTag}
  data-reveal-event={revealEvent}
  data-storage-key={storageKey}
  hidden
>
  <p class="consent-intro">Want to know how this turns out?</p>
  <label class="consent-email-label" for={`consent-email-${voteKey}`}>Email address</label>
  <input
    type="email"
    id={`consent-email-${voteKey}`}
    class="consent-email"
    data-consent-email
    placeholder="you@email.com"
    autocomplete="email"
  />
  <label class="consent-checkbox">
    <input type="checkbox" data-consent-transactional class="consent-check" />
    <span class="consent-check-box" aria-hidden="true"></span>
    <span>{transactionalLabel}</span>
  </label>
  <label class="consent-checkbox">
    <input type="checkbox" data-consent-marketing class="consent-check" />
    <span class="consent-check-box" aria-hidden="true"></span>
    <span>{marketingLabel}</span>
  </label>
  <p class="consent-helper">Checking the first box only sends you this one result — nothing else. Checking the second adds you to WAG Insider.</p>
  <button type="button" class="consent-submit" data-consent-submit>Save my preferences</button>
  <p class="consent-status" data-consent-status role="status" aria-live="polite"></p>
</div>

<script>
  function initConsentPairs() {
    document.querySelectorAll<HTMLElement>("[data-consent-pair]:not([data-consent-bound])").forEach((pair) => {
      pair.setAttribute("data-consent-bound", "true");
      const voteKey = pair.dataset.voteKey!;
      const apiEndpoint = pair.dataset.apiEndpoint || "/api/verdict-consent";
      const transactionalTag = pair.dataset.transactionalTag;
      const revealEvent = pair.dataset.revealEvent || "wag:voted";
      const storageKey = pair.dataset.storageKey || `wag_voted_${voteKey}`;
      const emailInput = pair.querySelector<HTMLInputElement>("[data-consent-email]")!;
      const transactionalBox = pair.querySelector<HTMLInputElement>("[data-consent-transactional]")!;
      const marketingBox = pair.querySelector<HTMLInputElement>("[data-consent-marketing]")!;
      const submitBtn = pair.querySelector<HTMLButtonElement>("[data-consent-submit]")!;
      const statusEl = pair.querySelector<HTMLElement>("[data-consent-status]")!;

      // Revealed only after a real vote is cast on this same widget --
      // never shown, never asked for, before that. Two paths reveal it,
      // not one: the live wag:voted event (cast a vote just now, same
      // page load) AND a direct localStorage check (already voted on a
      // past visit). Relying on the event alone is a real, confirmed bug
      // -- on a page reload, VoteWidget's own script runs first and
      // dispatches wag:voted synchronously for an already-voted visitor,
      // before this script has even attached its listener, so the event
      // fires into the void and the form stays hidden forever after the
      // first visit. The localStorage check below is what actually makes
      // a return visit work.
      if (localStorage.getItem(storageKey)) {
        pair.hidden = false;
      }
      document.addEventListener(revealEvent, (e) => {
        const target = e.target as HTMLElement;
        const detail = (e as CustomEvent).detail;
        const matches =
          target?.dataset?.voteKey === voteKey ||
          target?.dataset?.quizKey === voteKey ||
          detail?.voteKey === voteKey ||
          detail?.quizKey === voteKey;
        if (matches) {
          pair.hidden = false;
        }
      });

      submitBtn.addEventListener("click", async () => {
        const email = emailInput.value.trim();
        const transactional = transactionalBox.checked;
        const marketing = marketingBox.checked;

        if (!transactional && !marketing) {
          statusEl.textContent = "Check a box above if you'd like to hear from us.";
          return;
        }
        if (!email || !email.includes("@")) {
          statusEl.textContent = "That email doesn't look right — mind double-checking it?";
          emailInput.focus();
          return;
        }

        submitBtn.disabled = true;
        statusEl.textContent = "Saving...";

        if (typeof (window as any).gtag === "function") {
          if (transactional) (window as any).gtag("event", "consent_transactional_checked", { item_key: voteKey });
          if (marketing) (window as any).gtag("event", "consent_marketing_checked", { item_key: voteKey });
        }

        // Zero-friction first-party data: PollWidget/VoteWidget/QuizWidget
        // already write the visitor's real choice (vote option, quiz
        // result) into localStorage under this exact storageKey before
        // this form is ever revealed. Reading it here costs nothing new
        // to ask the visitor -- it just lets the server apply a specific
        // per-choice Beehiiv tag (e.g. wag-match-annabella) alongside the
        // existing participation tag, so "who matched Annabella" becomes
        // real, queryable audience data instead of being thrown away.
        // Questions Featured's storageKey holds only "1" (a flag, not a
        // real choice) -- the server-side allowlist naturally ignores
        // anything that isn't a recognized choice value, so this is safe
        // to always send.
        const choiceKey = localStorage.getItem(storageKey);

        try {
          const res = await fetch(apiEndpoint, {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ email, transactional, marketing, voteKey, itemKey: voteKey, transactionalTag, choiceKey }),
          });
          if (res.ok) {
            statusEl.textContent = "You're set — we'll be in touch.";
            emailInput.disabled = true;
            transactionalBox.disabled = true;
            marketingBox.disabled = true;
          } else {
            statusEl.textContent = "Something went wrong — try again in a moment.";
            submitBtn.disabled = false;
          }
        } catch {
          statusEl.textContent = "Something went wrong — try again in a moment.";
          submitBtn.disabled = false;
        }
      });
    });
  }

  initConsentPairs();
  document.addEventListener("astro:page-load", initConsentPairs);
</script>

<style>
  .consent-pair {
    margin-top: 20px; padding: 22px 24px; border-radius: var(--radius); border: 1px solid var(--line);
    background: var(--bg);
  }
  .consent-intro { font-family: var(--font-display); font-size: 1.15rem; margin: 0 0 14px; }
  .consent-email-label { display: block; font-size: .82rem; color: var(--ink-muted); margin-bottom: 6px; }
  .consent-email {
    width: 100%; padding: 12px 14px; border-radius: var(--radius-sm); border: 1px solid var(--line);
    background: var(--bg-alt); color: var(--ink); font: inherit; font-size: .96rem; margin-bottom: 16px;
  }
  .consent-email:focus { outline: none; border-color: var(--wag-green); }
  .consent-checkbox {
    display: flex; align-items: flex-start; gap: 12px; margin-bottom: 14px; cursor: pointer;
    font-size: .92rem; color: var(--ink-soft); line-height: 1.4;
  }
  /* Custom checkbox: the native input stays for accessibility/keyboard
     handling but is visually hidden; .consent-check-box is the branded
     replacement, styled by sibling selector off the input's :checked
     and :focus-visible states so it never falls out of sync with real
     input state (no separate JS needed to keep it in sync). */
  .consent-check {
    position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;
    overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border: 0;
  }
  .consent-check-box {
    flex-shrink: 0; width: 22px; height: 22px; margin-top: 1px; border-radius: 6px;
    border: 2px solid var(--line); background: var(--bg); position: relative;
    transition: border-color .15s ease, background .15s ease;
  }
  .consent-check-box::after {
    content: ""; position: absolute; inset: 0; margin: auto; width: 11px; height: 6px;
    border-left: 2px solid var(--wag-black); border-bottom: 2px solid var(--wag-black);
    transform: translateY(-1px) rotate(-45deg) scale(0); transition: transform .15s ease;
  }
  .consent-check:checked ~ .consent-check-box {
    border-color: var(--wag-green); background: var(--wag-green);
  }
  .consent-check:checked ~ .consent-check-box::after { transform: translateY(-1px) rotate(-45deg) scale(1); }
  .consent-check:focus-visible ~ .consent-check-box {
    outline: 2px solid var(--wag-pink); outline-offset: 2px;
  }
  .consent-checkbox:hover .consent-check-box { border-color: var(--wag-pink); }
  .consent-helper { font-size: .78rem; color: var(--ink-muted); margin: 4px 0 18px; }
  .consent-submit {
    font-family: var(--font-display); font-size: 1rem; padding: 12px 24px; border-radius: var(--radius-sm);
    border: none; background: var(--wag-pink); color: var(--wag-white); cursor: pointer;
  }
  .consent-submit:disabled { opacity: .6; cursor: default; }
  .consent-status { font-size: .84rem; color: var(--wag-green); margin: 10px 0 0; min-height: 1.2em; }
</style>
