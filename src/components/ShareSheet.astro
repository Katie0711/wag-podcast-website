---
// Real native share (Web Share API) on mobile -- the sheet a teenager
// already knows, straight to Messages/iMessage/WhatsApp/Instagram DMs --
// with a styled fallback menu of real deep-link share URLs for browsers
// that don't support navigator.share (most desktop browsers). Every link
// below is a real, working share target, not a placeholder icon.
interface Props {
  url: string; // absolute URL of the page being shared
  title: string;
  id?: string; // disambiguates multiple ShareSheets on one page (e.g. list cards)
}
const { url, title, id = "share" } = Astro.props;
const enc = encodeURIComponent;
---

<div class="share-sheet" data-share-sheet data-url={url} data-title={title}>
  <button type="button" class="share-trigger" data-share-trigger aria-haspopup="true" aria-expanded="false" aria-controls={`${id}-menu`}>
    📤 Share
  </button>
  <div class="share-menu" id={`${id}-menu`} data-share-menu hidden role="menu">
    <a role="menuitem" class="share-item" data-share-copy href="#">🔗 Copy link</a>
    <a role="menuitem" class="share-item" href={`sms:?&body=${enc(title + " " + url)}`}>💬 Text message</a>
    <a role="menuitem" class="share-item" href={`https://wa.me/?text=${enc(title + " " + url)}`} target="_blank" rel="noopener">🟢 WhatsApp</a>
    <a role="menuitem" class="share-item" data-share-messenger href={`fb-messenger://share/?link=${enc(url)}`}>💬 Messenger</a>
    <a role="menuitem" class="share-item" href={`https://twitter.com/intent/tweet?url=${enc(url)}&text=${enc(title)}`} target="_blank" rel="noopener">𝕏 X</a>
    <a role="menuitem" class="share-item" href={`https://www.facebook.com/sharer/sharer.php?u=${enc(url)}`} target="_blank" rel="noopener">📘 Facebook</a>
    <a role="menuitem" class="share-item" href={`mailto:?subject=${enc(title)}&body=${enc(url)}`}>✉️ Email</a>
  </div>
</div>

<script>
  function initShareSheets() {
    document.querySelectorAll<HTMLElement>("[data-share-sheet]:not([data-share-bound])").forEach((sheet) => {
      sheet.setAttribute("data-share-bound", "true");
      const url = sheet.dataset.url || location.href;
      const title = sheet.dataset.title || document.title;
      const trigger = sheet.querySelector<HTMLButtonElement>("[data-share-trigger]")!;
      const menu = sheet.querySelector<HTMLElement>("[data-share-menu]")!;
      const copyLink = sheet.querySelector<HTMLAnchorElement>("[data-share-copy]")!;
      const messengerLink = sheet.querySelector<HTMLAnchorElement>("[data-share-messenger]")!;

      // Messenger's fb-messenger:// scheme only resolves on a phone with
      // the app installed -- on desktop it just fails silently, so hide it
      // there rather than offer a dead link.
      const isTouchDevice = matchMedia("(pointer: coarse)").matches;
      if (!isTouchDevice) messengerLink.style.display = "none";

      const canNativeShare = typeof navigator.share === "function";

      trigger.addEventListener("click", async () => {
        if (canNativeShare) {
          try {
            await navigator.share({ title, url });
            return;
          } catch {
            // user cancelled or share failed -- fall through to the menu
          }
        }
        const isOpen = !menu.hidden;
        menu.hidden = isOpen;
        trigger.setAttribute("aria-expanded", String(!isOpen));
      });

      copyLink.addEventListener("click", async (e) => {
        e.preventDefault();
        try {
          await navigator.clipboard.writeText(url);
          const original = copyLink.textContent;
          copyLink.textContent = "✅ Copied!";
          setTimeout(() => { copyLink.textContent = original; }, 1600);
        } catch {
          window.prompt("Copy this link:", url);
        }
      });

      document.addEventListener("click", (e) => {
        if (!sheet.contains(e.target as Node)) {
          menu.hidden = true;
          trigger.setAttribute("aria-expanded", "false");
        }
      });
    });
  }

  initShareSheets();
  document.addEventListener("astro:page-load", initShareSheets);
</script>

<style>
  .share-sheet { position: relative; display: inline-block; }
  .share-trigger {
    font: inherit; font-weight: 600; font-size: .92rem; cursor: pointer;
    padding: 10px 18px; border-radius: var(--radius-sm); border: 1px solid var(--line);
    background: var(--bg-alt); color: var(--ink); transition: border-color .15s ease, transform .15s ease;
  }
  .share-trigger:hover { border-color: var(--wag-green); transform: translateY(-1px); }
  .share-menu {
    position: absolute; top: calc(100% + 8px); left: 0; z-index: 20;
    display: flex; flex-direction: column; min-width: 200px;
    background: var(--bg-alt); border: 1px solid var(--line); border-radius: var(--radius-sm);
    box-shadow: var(--shadow); padding: 6px; gap: 2px;
  }
  /* `display: flex` above has equal specificity to (and comes after, so
     wins over) the browser default `[hidden]{display:none}` -- without
     this, toggling the `hidden` attribute in JS silently does nothing
     and the menu never actually closes. This is the live bug: the share
     menu stays open once opened, on both mobile and desktop. */
  .share-menu[hidden] { display: none; }
  .share-item {
    display: block; padding: 9px 12px; border-radius: 8px; font-size: .92rem;
    color: var(--ink-soft); text-decoration: none; transition: background .12s ease;
  }
  .share-item:hover { background: rgba(165, 235, 14, .1); color: var(--ink); }
</style>
