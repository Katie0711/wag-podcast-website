---
const year = new Date().getFullYear();

const footerLinks = [
  { href: "/about/", label: "About" },
  { href: "/hosts/", label: "Hosts" },
  { href: "/watch/", label: "Watch" },
  { href: "/listen/", label: "Listen" },
  { href: "/faq/", label: "FAQ" },
  { href: "/sponsor/", label: "Sponsor" },
  { href: "/contact/", label: "Contact" },
];

// Real WAG Podcast IP -- formats, games, and topic collections. Kept as
// its own footer column so the flat page nav above doesn't get
// cluttered, while nothing stays orphaned/footer-only-reachable.
const exploreLinks = [
  { href: "/games/", label: "Games" },
  { href: "/guys-answer-questions/", label: "Guys Answer Questions" },
  { href: "/segments/", label: "Segments" },
  { href: "/topics/growing-up/", label: "Growing Up Stories" },
  { href: "/mental-health/", label: "Mental Health, Real Talk" },
  { href: "/teen-comedy-podcast/", label: "Teen Comedy Podcast" },
  { href: "/video-podcasts-for-teens/", label: "Why Video-First" },
  { href: "/wag-predicted-it/", label: "WAG Predicted It" },
];

// Podcast-specific channels plus the shared WAG social accounts --
// clips and episode content get cross-posted to Instagram/TikTok under
// the main WAG handles (confirmed real, same ones used sitewide on
// wildadventuregirls.com), not a separate unconfirmed podcast handle.
const listenLinks = [
  { href: "https://www.youtube.com/@WAGPodcast", label: "YouTube" },
  { href: "https://open.spotify.com/show/3tl7szlcJ5eFDqS7cbw6Kb", label: "Spotify" },
  { href: "https://podcasts.apple.com/us/podcast/wag-podcast/id1856707489", label: "Apple Podcasts" },
  { href: "https://www.instagram.com/wildadventuregirls/", label: "Instagram" },
  { href: "https://www.tiktok.com/@thewildadventuregirls", label: "TikTok" },
];
---

<footer class="site-footer">
  <div class="container footer-inner">
    <div class="footer-top">
      <div class="footer-brand-col">
        <a href="/" class="footer-brand">
          <img src="/images/wag-podcast-logo-400.png" alt="WAG Podcast" class="footer-logo" />
        </a>
        <p class="footer-tagline">WAG Podcast, from <a href="https://wildadventuregirls.com/">The Wild Adventure Girls</a> — a weekly video podcast hosted by Angelina, Scarlett, and Annabella.</p>
      </div>

      <nav class="footer-nav" aria-label="Footer">
        <span class="footer-col-label">Pages</span>
        <ul>
          {footerLinks.map((l) => (
            <li><a href={l.href}>{l.label}</a></li>
          ))}
        </ul>
      </nav>

      <nav class="footer-nav" aria-label="Explore WAG Podcast">
        <span class="footer-col-label">Explore</span>
        <ul>
          {exploreLinks.map((l) => (
            <li><a href={l.href}>{l.label}</a></li>
          ))}
        </ul>
      </nav>

      <nav class="footer-nav" aria-label="Follow WAG Podcast">
        <span class="footer-col-label">Follow</span>
        <ul class="footer-social">
          {listenLinks.map((s) => (
            <li><a href={s.href} target="_blank" rel="noopener">{s.label}</a></li>
          ))}
        </ul>
      </nav>
    </div>

    <div class="footer-bottom">
      <p>&copy; {year} The Wild Adventure Girls, Inc. All rights reserved. WAG PODCAST&trade; is a trademark (registration pending) of The Wild Adventure Girls, Inc.</p>
      <p class="footer-legal-links"><a href="https://wildadventuregirls.com/privacy/">Privacy Policy</a> &middot; <a href="https://wildadventuregirls.com/terms/">Terms of Service</a></p>
    </div>
  </div>
</footer>

<style>
  .site-footer{
    background: var(--wag-black);
    color: #fff;
    padding: 56px 0 28px;
  }
  .footer-top{
    display:grid; grid-template-columns: 1.3fr .85fr 1.15fr .85fr;
    align-items:start; gap:32px; padding-bottom:32px; border-bottom:1px solid #2A2A2E;
  }
  .footer-logo{ height:60px; }
  .footer-brand-col{ display:flex; flex-direction:column; gap:14px; }
  .footer-tagline{ color:#8A8A94; font-size:.85rem; line-height:1.5; margin:0; max-width:30ch; }
  .footer-tagline a{ color:#B4B4C4; text-decoration:underline; }
  .footer-tagline a:hover{ color:#fff; }
  .footer-nav{ display:flex; flex-direction:column; gap:14px; }
  .footer-col-label{
    font-family: var(--font-display); text-transform:uppercase; letter-spacing:.05em;
    font-size:.72rem; font-weight:700; color: var(--wag-green);
  }
  .footer-nav ul{ display:flex; flex-direction:column; gap:12px; }
  .footer-nav a{
    font-family: var(--font-display); text-transform:uppercase; letter-spacing:.03em;
    font-weight:600; font-size:.86rem; color:#fff; line-height:1.3;
  }
  .footer-nav a:hover{ color: var(--wag-green); }
  .footer-social{ display:flex; flex-direction:column; gap:14px; padding:0; margin:0; list-style:none; }
  .footer-social a{
    font-family: var(--font-display); text-transform:uppercase; letter-spacing:.03em;
    font-weight:600; font-size:.86rem; color:#fff;
  }
  .footer-social a:hover{ color: var(--wag-pink); }

  .footer-bottom{ padding-top:24px; }
  .footer-bottom p{ color:#8A8A94; font-size:.8rem; margin:0; line-height:1.6; }
  .footer-legal-links{ margin-top:.6em !important; }
  .footer-legal-links a{ color:#8A8A94; }
  .footer-legal-links a:hover{ color:#fff; }

  @media (max-width: 900px){
    .footer-top{ grid-template-columns: 1fr 1fr; row-gap:36px; }
  }
  @media (max-width: 560px){
    .footer-top{ grid-template-columns: 1fr; }
  }
</style>
