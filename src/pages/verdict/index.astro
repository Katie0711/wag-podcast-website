---
// The permanent home of WAG Verdict -- hub and live vote built as one
// product, per Katie's explicit direction. Server-rendered (not
// prerendered) so the aggregate shown on load is a real, live read from
// Netlify Blobs, not a stale build-time snapshot.
export const prerender = false;

import { getCollection, getEntry, render } from "astro:content";
import { getStore } from "@netlify/blobs";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import EqBars from "../../components/EqBars.astro";
import VoteWidget from "../../components/VoteWidget.astro";
import ConsentCheckboxPair from "../../components/ConsentCheckboxPair.astro";
import ArchiveList from "../../components/ArchiveList.astro";
import SponsorSlot from "../../components/SponsorSlot.astro";
import WhatsNext from "../../components/WhatsNext.astro";

const allVerdicts = await getCollection("verdicts");
const current = allVerdicts.find((v) => v.data.status === "current");
const archived = allVerdicts
  .filter((v) => v.data.status === "archived")
  .sort((a, b) => b.data.revealDate.getTime() - a.data.revealDate.getTime());

if (!current) {
  return new Response("No current Verdict configured", { status: 404 });
}

const sourceEpisode = await getEntry("episodes", current.data.sourceEpisode);

const store = getStore("wag-verdict-votes");
const counts = ((await store.get(current.data.voteKey, { type: "json" })) as { yes: number; no: number } | null) ?? {
  yes: 0,
  no: 0,
};

const archiveEntries = await Promise.all(
  archived.map(async (entry) => {
    const ep = await getEntry("episodes", entry.data.sourceEpisode);
    return {
      dilemma: entry.data.dilemma,
      revealText: entry.data.revealText,
      optionYes: entry.data.optionYes,
      optionNo: entry.data.optionNo,
      episodeHref: `/episodes/${entry.data.sourceEpisode}/`,
      episodeTitle: ep?.data.title ?? "",
    };
  })
);

// Explicit timeZone: "UTC" -- content dates parse as UTC midnight, and
// formatting in local time can silently shift the displayed day back by
// one (the same known bug class already tracked for episode dates
// elsewhere in this codebase). Force UTC so what's written in the
// content file is exactly what renders.
const revealDateFormatted = current.data.revealDate.toLocaleDateString("en-US", {
  month: "long",
  day: "numeric",
  timeZone: "UTC",
});

const faqs = [
  { q: "How does WAG Verdict work?", a: "Every week, WAG puts a real dilemma from the show to a vote. Cast your vote, see how everyone else is calling it, and find out what the girls actually decided when the next episode airs." },
  { q: "How do I vote?", a: "Tap either option above — no account or sign-in required. Your vote counts immediately." },
  { q: "When does the reveal happen?", a: "Each Verdict reveals in the next new episode. The real result — not just the vote percentage — airs there." },
];

const pageSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: "WAG Verdict",
  description: "Vote on the real dilemmas WAG Podcast debates — see how everyone else is calling it, then find out what the girls actually decided.",
  author: { "@type": "Organization", name: "WAG Podcast" },
  publisher: { "@type": "Organization", name: "The Wild Adventure Girls", url: "https://wildadventuregirls.com" },
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
};
---

<BaseLayout
  title="WAG Verdict — WAG Podcast"
  description="Vote on the real dilemmas WAG Podcast debates on camera. See how everyone else is calling it, then find out what the girls actually decided."
>
  <script type="application/ld+json" set:html={JSON.stringify(pageSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <section class="verdict-hero">
    <div class="container verdict-hero-grid" data-reveal>
      <div class="verdict-hero-copy">
        <Breadcrumb items={[{ label: "Home", href: "/" }, { label: "WAG Verdict", href: "/verdict/" }]} />
        <p class="eyebrow"><EqBars size="sm" /> WAG Verdict</p>
        <h1>Real dilemmas. <span class="text-accent">Your call.</span></h1>
        <p class="lede">Every week WAG puts a real debate from the show to a vote. Cast yours, see where everyone else lands, then find out what the girls actually decided.</p>
      </div>
      {sourceEpisode?.data.heroImage && (
        <a class="verdict-hero-photo" href={`/episodes/${current.data.sourceEpisode}/`} aria-label={`Watch: ${sourceEpisode.data.title}`}>
          <img src={sourceEpisode.data.heroImage} alt={sourceEpisode.data.title} loading="eager" />
          <span class="verdict-hero-photo-tag">From the real episode</span>
        </a>
      )}
    </div>
  </section>

  <section class="verdict-current">
    <div class="container container--narrow" data-reveal>
      <VoteWidget
        voteKey={current.data.voteKey}
        dilemma={current.data.dilemma}
        optionYes={current.data.optionYes}
        optionNo={current.data.optionNo}
        initialYes={counts.yes}
        initialNo={counts.no}
      />
      <ConsentCheckboxPair
        voteKey={current.data.voteKey}
        transactionalLabel="Email me when this Verdict is revealed"
        marketingLabel="Also join WAG Insider for future votes, quizzes, episodes, and product news"
      />
      <p class="verdict-reveal-note">Verdict revealed {revealDateFormatted} — in the next episode. Real percentage above, real outcome then.</p>
    </div>
  </section>

  <section class="verdict-sponsor">
    <div class="container container--narrow" data-reveal>
      <SponsorSlot
        fallbackHref="/watch/"
        fallbackLabel="🎬 While you're here — catch up on the latest WAG Podcast episode"
      />
    </div>
  </section>

  <section class="verdict-how">
    <div class="container container--narrow" data-reveal>
      <h2>How WAG Verdict works</h2>
      <div class="faq-list">
        {faqs.map((f) => (
          <div class="faq-item">
            <h3>{f.q}</h3>
            <p>{f.a}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="verdict-related">
    <div class="container container--narrow" data-reveal>
      <h2>From the episode</h2>
      <a class="related-episode" href={`/episodes/${current.data.sourceEpisode}/`}>
        <img src={sourceEpisode?.data.heroImage} alt={sourceEpisode?.data.title} loading="lazy" />
        <div>
          <h3>{sourceEpisode?.data.title}</h3>
          <span class="related-link">Watch the real episode →</span>
        </div>
      </a>
    </div>
  </section>

  <section class="verdict-archive">
    <div class="container container--narrow" data-reveal>
      <h2>Previous Verdicts</h2>
      <ArchiveList entries={archiveEntries} />
    </div>
  </section>

  <WhatsNext
    items={[
      { icon: "❓", label: "Guys Answer Questions", href: "/guys-answer-questions/" },
      { icon: "🎬", label: "Watch every episode", href: "/watch/" },
      { icon: "😂", label: "WAG Podcast Games", href: "/games/" },
    ]}
    shareUrl="https://thewagpodcast.com/verdict/"
    shareTitle="WAG Verdict — WAG Podcast"
    insiderPage="verdict"
  />
</BaseLayout>

<style>
  .verdict-hero { padding: 32px 0 20px; }
  .verdict-hero-grid { display: grid; grid-template-columns: 1.15fr 1fr; gap: 40px; align-items: center; }
  .eyebrow { display: inline-flex; align-items: center; gap: 10px; color: var(--wag-green); margin-top: 14px; }
  .verdict-hero h1 { font-size: clamp(2rem, 4.2vw, 3.1rem); max-width: 22ch; }
  .text-accent {
    background: linear-gradient(90deg, var(--wag-pink) 0%, var(--wag-green) 100%);
    -webkit-background-clip: text; background-clip: text; color: transparent;
  }
  .lede { font-size: 1.05rem; max-width: 60ch; color: var(--ink-soft); }
  .verdict-hero-photo {
    position: relative; display: block; border-radius: var(--radius-lg); overflow: hidden;
    aspect-ratio: 4/5; border: 1px solid var(--line); box-shadow: var(--shadow);
  }
  .verdict-hero-photo img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform .3s ease; }
  .verdict-hero-photo:hover img { transform: scale(1.03); }
  .verdict-hero-photo-tag {
    position: absolute; left: 14px; bottom: 14px; padding: 7px 14px; border-radius: 999px;
    background: rgba(10, 10, 10, .72); backdrop-filter: blur(4px); color: var(--wag-white);
    font-family: var(--font-display); font-size: .72rem; text-transform: uppercase; letter-spacing: .06em;
  }
  @media (max-width: 820px) {
    .verdict-hero-grid { grid-template-columns: 1fr; gap: 22px; }
    .verdict-hero-photo { aspect-ratio: 16/9; order: -1; }
  }

  .container--narrow { max-width: 680px; }

  .verdict-current { padding: 12px 0 24px; }
  .verdict-reveal-note { font-size: .84rem; color: var(--ink-muted); text-align: center; margin-top: 16px; }

  .verdict-sponsor { padding: 0 0 32px; }

  .verdict-how { padding: 12px 0 40px; }
  .verdict-how h2, .verdict-related h2, .verdict-archive h2 { font-size: 1.5rem; margin-bottom: 18px; }
  .faq-list { display: flex; flex-direction: column; gap: 18px; }
  .faq-item h3 { font-family: var(--font-body); font-weight: 700; text-transform: none; letter-spacing: 0; font-size: 1rem; margin-bottom: 6px; }
  .faq-item p { font-size: .92rem; color: var(--ink-soft); margin: 0; }

  .verdict-related { padding: 0 0 40px; }
  .related-episode {
    display: flex; gap: 16px; align-items: center; padding: 14px; border-radius: var(--radius);
    border: 1px solid var(--line); background: var(--bg-alt); text-decoration: none; color: var(--ink);
    transition: border-color .15s ease;
  }
  .related-episode:hover { border-color: var(--wag-pink); }
  .related-episode img { width: 120px; aspect-ratio: 16/9; object-fit: cover; border-radius: var(--radius-sm); flex-shrink: 0; }
  .related-episode h3 { font-family: var(--font-body); font-weight: 700; text-transform: none; letter-spacing: 0; font-size: .98rem; margin: 0 0 6px; }
  .related-link { font-size: .84rem; color: var(--wag-green); font-weight: 600; }

  .verdict-archive { padding: 0 0 32px; }
</style>
