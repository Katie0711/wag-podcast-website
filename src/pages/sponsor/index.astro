---
import BaseLayout from "../../layouts/BaseLayout.astro";
import EqBars from "../../components/EqBars.astro";
import Marquee from "../../components/Marquee.astro";

// Real brand partners, sourced from WAG's own sponsor deck/brand
// playbook -- these are Wild Adventure Girls partnerships (licensing,
// commercial features, campaigns), not claimed as podcast-specific ad
// buys, since that distinction matters and isn't documented either way.
// Corroborated across two independent real sources this session: the
// WAG Podcast media kit one-sheeter and the Fall 2025 sponsorship deck.
const brandPartners = [
  "Nintendo", "Google", "UpFaith & Family", "Razor USA",
  "Get Epic!", "The Toy Insider", "Hexbug USA", "NSI International", "Dynacraft",
];

// Real, verified numbers only -- WAG Podcast's own channel performance
// (from Katie's own YouTube Studio dashboard) kept clearly separate
// from the parent brand's numbers (from the WAG media kit / sponsor
// deck), since conflating "the podcast has X" with "the team behind it
// has X" would be a real, material overstatement. No launch date and
// no subscriber-delta number here per explicit direction -- the raw
// growth number reads as unimpressive next to the real story, which is
// "new and fast-growing," not a specific subscriber count.
const podcastStats = [
  { num: "3.8M+", label: "Views to Date" },
  { num: "Weekly", label: "New Episode, Every Week" },
];
const teamStats = [
  { num: "1.2M+", label: "Subscribers" },
  { num: "1B+", label: "Lifetime Views" },
];

// Real audience data, corroborated across the same two real sources
// (media kit + Fall 2025 deck) and consistent with the numbers already
// live on wildadventuregirls.com/brand-partnerships.
const audienceStats = [
  { num: "70%", label: "Female Audience" },
  { num: "11–18", label: "Primary Ages" },
  { num: "80%", label: "U.S.-Based" },
];

// Real recurring content territory, matching what's already live on
// the About page and Segments hub -- not invented for this page.
const contentPillars = ["Trending Pop Culture", "Friendship & Relationships", "Real Talk", "Party Games & Dares", "Growing Up Stories", "Comedy"];

// Real, already-published, already-fact-checked case studies -- same
// source as wildadventuregirls.com/brand-partnerships (the 2026 Brand
// Playbook), condensed here so a buyer doesn't have to leave this site
// to see proof, not just names. These are real Wild Adventure Girls
// (parent brand) partnerships, not WAG Podcast-specific ones -- framed
// that way honestly, same distinction this page already draws between
// "WAG Podcast" and "the team behind it" in the stat strip above. No
// photo here is claimed as a still from the campaign itself -- real
// studio photography, real campaign facts, not conflated as the same
// image.
const caseStudies = [
  {
    brand: "Nintendo",
    headline: "A real, paid integration with one of the biggest names in gaming.",
    body: "When Nintendo needed an authentic voice to reach real teen girls, they came to the WAG team — a real integration built around one of their titles, delivered across Instagram Reel + Story and YouTube Shorts, not a scripted ad read.",
    quote: "It's been a pleasure working together!",
    quoteAuthor: "Samantha, Senior Manager, Golin (Nintendo America)",
    photo: "/images/studio/wag-studio-191-card.jpg",
    photoWebp: "/images/studio/wag-studio-191-card.webp",
    photoAlt: "Angelina, Scarlett, and Annabella filming in the real WAG studio",
  },
  {
    brand: "UpFaith & Family — Heartland Season 17",
    headline: "A promotional campaign that grew into a live event.",
    body: "A Heartland Season 17 promotional campaign that expanded into hosting the real Heartland Fan Fest in person — a real, in-person moment with the girls, not just a video mention.",
    quote: "Working with The Wild Adventure Girls on the “Heartland” Season 17 promotional campaign has been an outstanding experience. They brought creativity and excitement to the project, which culminated in the successful hosting of the “Heartland” Fan Fest.",
    quoteAuthor: "Zoie Taylor, Coordinator, Streaming Services (UpFaith & Family)",
    photo: "/images/studio/wag-studio-221-card.jpg",
    photoWebp: "/images/studio/wag-studio-221-card.webp",
    photoAlt: "The real WAG Podcast set, checkerboard floor and neon sign",
  },
  {
    brand: "Epic",
    headline: "100+ videos licensed to a platform reaching real classrooms nationwide.",
    body: "Over 100 real videos licensed to Epic, a platform with real distribution reaching approximately 90% of U.S. public schools.",
    photo: "/images/studio/wag-studio-274-card.jpg",
    photoWebp: "/images/studio/wag-studio-274-card.webp",
    photoAlt: "A real behind-the-scenes moment from a WAG Podcast shoot day",
  },
];

// Available ad/partnership formats -- described as offerings, not
// claimed past campaigns. Standing rule: never write copy implying WAG
// doesn't take brand deals -- this frames it as available, not absent.
const formats = [
  { name: "In-episode mentions", desc: "A natural, spoken mention worked into the real conversation, not a pre-roll ad read." },
  { name: "Sponsored segments", desc: "A brand woven into one of the show's real recurring segments — Squad Dares, 3-Second Roast, and others." },
  { name: "Product integration", desc: "A product used, tested, or reacted to on camera as part of an episode, the same way WAG features products elsewhere." },
  { name: "Co-branded episode", desc: "A full episode built around a brand, product, or campaign, credited clearly to the partner." },
];

// Real, live sponsorship inventory -- not a future promise. Every
// interaction listed here already has a working SponsorSlot in
// production (unfilled slots render a WAG-owned fallback CTA; the
// moment a sponsor is sold, the real placement goes live with zero
// template changes needed). Kept as its own featured format, not
// folded into the four episode-based ones above, since it's a
// structurally different kind of inventory -- owned, interactive,
// first-party -- not just another ad placement.
const interactionInventory = [
  { name: "WAG Verdict", desc: "A brand presence on the weekly real-dilemma vote — real participation, real audience attention, every week." },
  { name: "WAG Match", desc: "Sponsor the quiz that tells a fan which real WAG host they're most like — high completion, high replay." },
  { name: "WAG Awards", desc: "Attach a brand to a real, ongoing fan-voted category." },
  { name: "Questions Featured", desc: "A brand presence on the real fan-submission format that feeds new Guys Answer Questions episodes." },
];

// Every answer here is a real, already-established fact -- matching the
// same audience/partner/format data already on this page, or facts
// already published on the site's own FAQ. No minimum-commitment,
// exclusivity, or turnaround-time answers, since those aren't decided
// yet and shouldn't be invented for this page.
const faqs = [
  {
    q: "Is WAG Podcast part of a bigger brand?",
    a: "Yes — WAG Podcast is the interactive, conversation-driven extension of The Wild Adventure Girls, a youth entertainment media company with a decade of real audience-building, 1.2M+ YouTube subscribers, and 1B+ lifetime views across the wider brand.",
  },
  {
    q: "What audience does WAG Podcast reach?",
    a: "WAG Podcast's audience skews 70% female, primarily ages 11–18, and about 80% U.S.-based.",
  },
  {
    q: "Has WAG Podcast's team partnered with brands before?",
    a: "Yes — brands including Nintendo, Google, UpFaith & Family, Razor USA, Get Epic!, The Toy Insider, Hexbug USA, NSI International, and Dynacraft have all partnered with the wider Wild Adventure Girls brand.",
  },
  {
    q: "What kind of content is WAG Podcast?",
    a: "Weekly, unscripted episodes recorded in the girls' own studio — real conversations and real reactions, not a scripted ad read.",
  },
  {
    q: "Where does WAG Podcast publish episodes?",
    a: "New episodes go live weekly on YouTube first, followed by audio versions on Spotify and Apple Podcasts.",
  },
  {
    q: "How do I get in touch about sponsoring?",
    a: "Fill out the form below or email partners@wagstudios.co directly — pricing and packages are discussed one-on-one, not posted publicly.",
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
};
---

<BaseLayout
  title="Sponsor WAG Podcast — Advertising & Partnerships"
  description="Sponsor WAG Podcast — a fast-growing weekly show for teens. Real audience data, brand-safe unscripted content, and four ways to partner with the show."
  ogImage="/images/studio/wag-studio-195.jpg"
>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <section class="sponsor-hero">
    <div class="hero-photo">
      <picture>
        <source srcset="/images/studio/wag-studio-137.webp" type="image/webp" />
        <img src="/images/studio/wag-studio-137.jpg" alt="Angelina, Scarlett, and Annabella on the WAG Podcast set" fetchpriority="high" />
      </picture>
      <div class="hero-photo-fade" aria-hidden="true"></div>
      <div class="hero-kit-badge">WAG Podcast<br />Sponsorships</div>
    </div>
    <div class="hero-text">
      <div class="hero-glow" aria-hidden="true"></div>
      <div class="container hero-inner">
        <p class="eyebrow"><EqBars size="sm" /> Sponsor WAG Podcast</p>
        <h1>Sponsor <span class="text-accent">WAG Podcast</span>.</h1>
        <p class="lede">A new, fast-growing weekly video podcast for teens — real talk, real chaos, real reactions, from the team behind The Wild Adventure Girls. Every episode feels like sitting in on the group chat, only millions are watching.</p>
        <a class="btn btn-accent" href="#partner">Become a Sponsor →</a>
      </div>
    </div>
  </section>

  <section class="stat-strip">
    <div class="container" data-reveal="stagger">
      <div class="stat-group">
        <p class="stat-group-label">WAG Podcast</p>
        <div class="stat-row">
          {podcastStats.map((s) => (
            <div class="stat"><span class="stat-num">{s.num}</span><span class="stat-label">{s.label}</span></div>
          ))}
        </div>
      </div>
      <div class="stat-divider" aria-hidden="true"></div>
      <div class="stat-group">
        <p class="stat-group-label">The team behind it — The Wild Adventure Girls</p>
        <div class="stat-row">
          {teamStats.map((s) => (
            <div class="stat"><span class="stat-num">{s.num}</span><span class="stat-label">{s.label}</span></div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <nav class="jumpnav" aria-label="Sponsor page sections">
    <div class="container jumpnav-inner">
      <a href="#audience">Audience</a>
      <a href="#sponsorships">Sponsorships</a>
      <a href="#brands">Brands</a>
      <a href="#case-studies">Case Studies</a>
      <a href="#formats">Partnership Formats</a>
      <a href="#brand-safety">Brand Safety</a>
      <a href="#faq">FAQ</a>
      <a href="#partner">Let's Talk</a>
    </div>
  </nav>

  <section class="audience-section" id="audience">
    <div class="audience-glow" aria-hidden="true"></div>
    <div class="container" data-reveal>
      <p class="eyebrow"><EqBars size="sm" /> Who's Watching</p>
      <h2>The audience every brand wants and few can reach.</h2>
      <div class="audience-row">
        {audienceStats.map((s, i) => (
          <div class={`audience-stat accent-${i % 2 === 0 ? "pink" : "green"}`}>
            <span class="stat-num">{s.num}</span>
            <span class="stat-label">{s.label}</span>
          </div>
        ))}
      </div>
      <p class="audience-note">Platform-obsessed — YouTube, TikTok, Spotify, and Instagram, all at once.</p>
    </div>
  </section>

  <section class="inventory-section" id="sponsorships">
    <div class="inventory-glow" aria-hidden="true"></div>
    <div class="container" data-reveal>
      <p class="eyebrow"><EqBars size="sm" /> Owned, First-Party Inventory</p>
      <h2>Beyond the episode — a real interactive platform.</h2>
      <p class="inventory-intro">WAG Podcast isn't just a video feed. Every episode connects to a real, live interactive platform — polls, quizzes, and fan-voted formats fans actually return to, every week. This is sponsorship inventory no other podcast has, because no other podcast built it.</p>
      <div class="inventory-grid">
        {interactionInventory.map((item, i) => (
          <div class={`inventory-card accent-${i % 2 === 0 ? "pink" : "green"}`}>
            <span class="inventory-live">● Live Now</span>
            <h3>{item.name}</h3>
            <p>{item.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="brand-section" id="brands">
    <div class="container brand-lede" data-reveal>
      <p class="eyebrow"><EqBars size="sm" /> Brands Who Trust Us</p>
      <p class="lede-text">We've partnered with some of the biggest brands in entertainment, gaming, technology, and consumer products — brands who trust us because we deliver fans, reach, and real results.</p>
    </div>
  </section>

  <Marquee items={brandPartners} />

  <section class="case-studies-section" id="case-studies">
    <div class="container" data-reveal>
      <p class="eyebrow"><EqBars size="sm" /> Proof, Not Just Logos</p>
      <h2>What partnering with the WAG team has actually looked like.</h2>
      <p class="case-studies-intro">These are real Wild Adventure Girls partnerships — the parent brand behind WAG Podcast — not podcast-specific ad buys. For the full case studies and campaign results, see <a href="https://wildadventuregirls.com/brand-partnerships/">Work With WAG →</a></p>
      <div class="case-studies-grid">
        {caseStudies.map((c) => (
          <div class="case-study-card">
            <picture class="case-study-photo">
              <source srcset={c.photoWebp} type="image/webp" />
              <img src={c.photo} alt={c.photoAlt} loading="lazy" />
            </picture>
            <div class="case-study-body">
              <p class="case-study-brand">{c.brand}</p>
              <h3>{c.headline}</h3>
              <p class="case-study-text">{c.body}</p>
              {c.quote && (
                <blockquote class="case-study-quote">
                  <p>“{c.quote}”</p>
                  <cite>— {c.quoteAuthor}</cite>
                </blockquote>
              )}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="photo-break">
    <picture>
      <source srcset="/images/studio/wag-studio-333.webp" type="image/webp" />
      <img src="/images/studio/wag-studio-333.jpg" alt="Annabella and Scarlett reacting on the WAG Podcast set" loading="lazy" />
    </picture>
    <div class="photo-break-scrim"></div>
    <p class="photo-break-caption">Every episode, filmed live in their own studio — checkerboard set, neon sign, real reactions.</p>
  </section>

  <section class="video-proof-section">
    <div class="container video-proof-inner" data-reveal>
      <div class="video-proof-text">
        <p class="eyebrow"><EqBars size="sm" /> See The Real Energy</p>
        <h2>Not a sizzle reel — an actual episode.</h2>
        <p>This is real, unscripted WAG Podcast — the same energy a sponsored segment or product integration would run inside. Watch a few minutes and you'll see exactly what a brand is stepping into.</p>
      </div>
      <div class="video-proof-embed">
        <iframe
          src="https://www.youtube.com/embed/mCfeIZst5qQ"
          title="WAG Podcast — Dating Red Flags: Would You Still Date Him If...?"
          loading="lazy"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
          allowfullscreen
        ></iframe>
      </div>
    </div>
  </section>

  <section class="reach-section" id="reach">
    <div class="container" data-reveal>
      <p class="eyebrow"><EqBars size="sm" /> What Sponsors Get Exposure To</p>
      <p class="reach-copy">WAG Podcast reaches the same core teen and tween audience that follows The Wild Adventure Girls — a brand with a real, established YouTube presence built over more than a decade. Every episode covers real, recurring territory:</p>
      <ul class="pillar-pills">
        {contentPillars.map((p, i) => <li class={i % 2 === 0 ? "pill-pink" : "pill-green"}>{p}</li>)}
      </ul>
    </div>
  </section>

  <section class="formats-section" id="formats">
    <div class="container" data-reveal="stagger">
      <p class="eyebrow"><EqBars size="sm" /> How It Works</p>
      <h2>Four ways to partner with the show.</h2>
      <p class="formats-intro">WAG Podcast is a weekly, unscripted show with real recurring segments — that format opens up a few different ways to partner:</p>
      <div class="formats-grid">
        {formats.map((f, i) => (
          <div class={`format-card accent-${i % 2 === 0 ? "pink" : "green"}`}>
            <span class="format-index">{String(i + 1).padStart(2, "0")}</span>
            <h3>{f.name}</h3>
            <p>{f.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="safety-section" id="brand-safety">
    <div class="container" data-reveal>
      <p class="eyebrow"><EqBars size="sm" /> Brand Safety</p>
      <h2>Real, but never reckless.</h2>
      <p class="safety-copy">WAG Podcast is unscripted — real conversations and real reactions, filmed in the girls' own studio, for the same teen and tween audience The Wild Adventure Girls have built over more than a decade, not younger children. The girls' privacy comes first: we don't publish their exact location or last names anywhere on this site.</p>
    </div>
  </section>

  <section class="faq-section" id="faq">
    <div class="container" data-reveal="stagger">
      <p class="eyebrow"><EqBars size="sm" /> FAQ</p>
      <h2>Quick answers before you reach out.</h2>
      <div class="faq-list">
        {faqs.map((f) => (
          <div class="faq-item">
            <h3>{f.q}</h3>
            <p>{f.a}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="sponsor-cta" id="partner">
    <div class="container cta-inner" data-reveal>
      <div class="cta-photo">
        <picture>
          <source srcset="/images/studio/wag-studio-283.webp" type="image/webp" />
          <img src="/images/studio/wag-studio-283.jpg" alt="A WAG Podcast host on the studio couch" loading="lazy" />
        </picture>
        <div class="cta-photo-glow" aria-hidden="true"></div>
        <div class="cta-photo-badge">We reply personally — no bots.</div>
      </div>

      <div class="cta-copy">
        <p class="eyebrow"><EqBars size="sm" /> Let's Talk</p>
        <h2>Let's build something worth showing off.</h2>
        <p class="cta-note">Tell us about your brand and what you're looking to do — pricing and packages are discussed directly, not posted publicly.</p>
        <p class="cta-email">Or email us directly: <a href="mailto:partners@wagstudios.co?subject=WAG%20Podcast%20Sponsorship">partners@wagstudios.co</a></p>

        <form class="sponsor-form" name="wagpodcast-sponsor-inquiry" method="POST" data-netlify="true" netlify-honeypot="bot-field" data-astro-reload>
          <input type="hidden" name="form-name" value="wagpodcast-sponsor-inquiry" />
          <input type="hidden" name="referring-page" id="sponsor-referring-page" value="" />
          <p class="sr-only"><label>Leave this field blank: <input name="bot-field" tabindex="-1" autocomplete="off" /></label></p>

          <div class="form-row">
            <div>
              <label for="sponsor-name">Name</label>
              <input id="sponsor-name" name="name" type="text" required />
            </div>
            <div>
              <label for="sponsor-email">Email</label>
              <input id="sponsor-email" name="email" type="email" required />
            </div>
          </div>

          <label for="sponsor-company">Company / Brand</label>
          <input id="sponsor-company" name="company" type="text" required />

          <label for="sponsor-interest">What are you looking to do?</label>
          <select id="sponsor-interest" name="interest">
            <option>In-Episode Mention</option>
            <option>Sponsored Segment</option>
            <option>Product Integration</option>
            <option>Co-Branded Episode</option>
            <option>Something Else</option>
          </select>

          <label for="sponsor-message">Tell us about your brand</label>
          <textarea id="sponsor-message" name="message" rows="4" required></textarea>

          <button class="btn btn-accent" type="submit">Send Inquiry →</button>
        </form>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  function fillReferringPage() {
    const field = document.getElementById("sponsor-referring-page") as HTMLInputElement | null;
    if (field && !field.value) field.value = document.referrer || "direct";
  }
  fillReferringPage();
  document.addEventListener("astro:page-load", fillReferringPage);
</script>

<style>
  /* Photo and headline no longer share the same frame -- the previous
     overlay put "Advertise with WAG Podcast." directly on top of the
     real WAG PODCAST neon sign in the shot, two competing pieces of
     text in one glance. Photo now gets its own full, undarkened
     section; text gets a separate section below with real glow but no
     photo behind it, so nothing is ever fighting for the same space. */
  .sponsor-hero{ position:relative; }
  .hero-photo{ position:relative; width:100%; aspect-ratio: 2.1/1; overflow:hidden; }
  .hero-photo img{ width:100%; height:100%; object-fit:cover; object-position: center 28%; display:block; }
  .hero-photo-fade{
    position:absolute; inset:0;
    background: linear-gradient(0deg, rgba(10,10,15,.9) 0%, transparent 22%);
  }
  .hero-kit-badge{
    position:absolute; z-index:2; top:24px; right:24px; max-width:170px;
    background: var(--wag-pink); color:#fff; border-radius: var(--radius-sm);
    padding:.8em 1.05em; font-family: var(--font-display); text-transform:uppercase;
    letter-spacing:.02em; font-weight:700; font-size:.8rem; line-height:1.3; text-align:center;
    box-shadow: var(--shadow-sm); transform: rotate(3deg);
  }
  .hero-text{ position:relative; background: var(--wag-black); padding: 52px 0 64px; overflow:hidden; }
  .hero-glow{
    position:absolute; inset:0; z-index:0; pointer-events:none; mix-blend-mode:screen; opacity:.5;
    background:
      radial-gradient(ellipse 40% 70% at 8% 0%, var(--wag-pink) 0%, transparent 70%),
      radial-gradient(ellipse 35% 60% at 100% 0%, var(--wag-green) 0%, transparent 70%);
  }
  .hero-inner{ position:relative; z-index:1; max-width:68ch; }
  .sponsor-hero .eyebrow{ color: var(--wag-green); }
  .sponsor-hero h1{ font-size: clamp(2.4rem, 4.8vw, 3.8rem); max-width:18ch; color:#fff; }
  .text-accent{
    background: linear-gradient(90deg, var(--wag-pink) 0%, var(--wag-green) 100%);
    -webkit-background-clip:text; background-clip:text; color:transparent;
  }
  .sponsor-hero .lede{ font-size:1.15rem; max-width:58ch; color:#E7E7EE; margin-bottom:1.4em; }

  @media (max-width: 700px){
    .hero-photo{ aspect-ratio: 4/3; }
    .hero-kit-badge{ top:16px; right:16px; max-width:140px; font-size:.72rem; }
    .hero-text{ padding: 40px 0 48px; }
  }

  @media (max-width: 700px){
    .sponsor-hero{ min-height:520px; padding: 100px 0 48px; }
    .hero-kit-badge{ top:20px; right:16px; max-width:140px; font-size:.72rem; }
  }

  .stat-strip{ background: var(--wag-black); border-top:1px solid #2A2A2E; padding: 44px 0; }
  .stat-strip .container{ display:flex; align-items:center; gap:56px; flex-wrap:wrap; }
  .stat-group{ display:flex; flex-direction:column; gap:16px; }
  .stat-group-label{
    font-family: var(--font-display); text-transform:uppercase; letter-spacing:.05em;
    font-size:.75rem; font-weight:700; color: var(--wag-green); margin:0;
  }
  .stat-row{ display:flex; gap:48px; flex-wrap:wrap; }
  .stat{ display:flex; flex-direction:column; gap:2px; }
  .stat-num{ font-family: var(--font-display); font-size: clamp(2.4rem, 5vw, 3.4rem); font-weight:700; color:#fff; line-height:1; }
  .stat-label{ font-size:.88rem; color:#9C9CB0; }
  .stat-divider{ width:1px; align-self:stretch; background:#2A2A38; }

  .jumpnav{ background: var(--wag-black); border-bottom:1px solid #2A2A2E; }
  .jumpnav-inner{ display:flex; gap:32px; flex-wrap:wrap; padding:16px 24px; }
  .jumpnav a{
    position:relative; font-family: var(--font-display); text-transform:uppercase; letter-spacing:.05em;
    font-size:.82rem; font-weight:700; color:#B4B4C4; padding-bottom:4px;
  }
  .jumpnav a::after{
    content:""; position:absolute; left:0; right:100%; bottom:0; height:2px;
