---
import BaseLayout from "../../layouts/BaseLayout.astro";
import EqBars from "../../components/EqBars.astro";
import { insiderHref } from "../../lib/insiderLink";

// Podcast-specific: their on-show roles and dynamic, not a rewrite of
// their full WAG bios (those stay authoritative at
// wildadventuregirls.com/girls/[name] -- linked below, not duplicated).
const hosts = [
  {
    name: "Annabella",
    role: "The Wild Card",
    photo: "/images/annabella-thumb.jpg",
    photoWebp: "/images/annabella-thumb.webp",
    bio: "Her reactions are the moments that get clipped and turned into memes. Annabella's the one who says the thing everyone's thinking before anyone else does.",
    profileUrl: "https://wildadventuregirls.com/girls/annabella/",
  },
  {
    name: "Scarlett",
    role: "The Quick-Witted Instigator",
    photo: "/images/scarlett-thumb.jpg",
    photoWebp: "/images/scarlett-thumb.webp",
    bio: "Her one-liners become the soundbites everyone quotes. Scarlett's the one who asks the question that actually gets an honest answer.",
    profileUrl: "https://wildadventuregirls.com/girls/scarlett/",
  },
  {
    name: "Angelina",
    role: "The Voice of Reason",
    photo: "/images/angelina-thumb.jpg",
    photoWebp: "/images/angelina-thumb.webp",
    bio: "She's the one who keeps the conversation actually going somewhere. Angelina makes every episode relatable instead of chaotic for its own sake.",
    profileUrl: "https://wildadventuregirls.com/girls/angelina/",
  },
];

const pageSchema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: "Hosts — WAG Podcast",
  description: "Meet the three hosts of WAG Podcast: Angelina, Scarlett, and Annabella — real sisters and a cousin, not a cast.",
  url: "https://thewagpodcast.com/hosts/",
  mainEntity: {
    "@type": "ItemList",
    itemListElement: hosts.map((h, i) => ({
      "@type": "ListItem",
      position: i + 1,
      item: { "@type": "Person", name: h.name, description: h.role, url: h.profileUrl },
    })),
  },
};
---

<BaseLayout
  title="Hosts — WAG Podcast"
  description="Meet the three hosts of WAG Podcast: Angelina, Scarlett, and Annabella — real sisters and a cousin, not a cast."
  ogImage="/images/studio/wag-studio-137.jpg"
>
  <script type="application/ld+json" set:html={JSON.stringify(pageSchema)} />
  <section class="hosts-hero">
    <div class="hero-photo">
      <picture>
        <source srcset="/images/studio/wag-studio-137.webp" type="image/webp" />
        <img src="/images/studio/wag-studio-137.jpg" alt="Angelina, Scarlett, and Annabella together on the WAG Podcast set" fetchpriority="high" />
      </picture>
      <div class="hero-scrim"></div>
    </div>
    <div class="container hero-inner">
      <p class="eyebrow"><EqBars size="sm" /> Hosts</p>
      <h1>Three <span class="text-accent">personalities</span>. Zero filter.</h1>
      <p class="lede">Angelina, Scarlett, and Annabella — real sisters and a cousin, so the dynamic on screen is a real family relationship, not a cast assembled for a show.</p>
    </div>
  </section>

  <section class="hosts-list">
    <div class="container" data-reveal="stagger">
      {hosts.map((h) => (
        <div class="host-row">
          <picture>
            <source srcset={h.photoWebp} type="image/webp" />
            <img src={h.photo} alt={h.name} loading="lazy" />
          </picture>
          <div class="host-row-body">
            <span class="host-role">{h.role}</span>
            <h2>{h.name}</h2>
            <p>{h.bio}</p>
            <a class="host-profile-link" href={h.profileUrl}>Full profile on Wild Adventure Girls →</a>
          </div>
        </div>
      ))}
    </div>
  </section>

  <section class="hosts-cta">
    <div class="container">
      <p>See them in action. <a href="/watch/">Watch an episode →</a></p>
    </div>
  </section>

  <section class="join">
    <div class="container register-light join-inner" data-reveal>
      <h2>Never miss a new episode.</h2>
      <p>Join WAG Insider for new-episode alerts and behind-the-scenes extras — the same free list the main WAG site uses, one signup for everything WAG.</p>
      <a class="btn btn-primary" href={insiderHref("hosts")}>Join WAG Insider →</a>
    </div>
  </section>
</BaseLayout>

<style>
  .hosts-hero{ position:relative; padding: 0 0 32px; }
  .hero-photo{ position:relative; width:100%; aspect-ratio: 2.6/1; overflow:hidden; margin-bottom:40px; }
  .hero-photo img{ width:100%; height:100%; object-fit:cover; object-position: center 22%; display:block; }
  .hero-scrim{ position:absolute; inset:0; background: linear-gradient(0deg, rgba(10,10,15,.75) 0%, transparent 45%); }
  .hero-inner{ max-width:68ch; }
  .eyebrow{ display:inline-flex; align-items:center; gap:10px; }
  .hosts-hero h1{ font-size: clamp(2rem, 4.2vw, 3.1rem); max-width:20ch; }
  .text-accent{
    background: linear-gradient(90deg, var(--wag-pink) 0%, var(--wag-green) 100%);
    -webkit-background-clip:text; background-clip:text; color:transparent;
  }
  .lede{ font-size:1.1rem; max-width:60ch; }

  .hosts-list{ padding: 48px 0; display:flex; flex-direction:column; gap:36px; }
  .host-row{
    display:grid; grid-template-columns: 220px 1fr; gap:32px; align-items:center;
    padding:20px; border-radius: var(--radius-lg); border:1px solid transparent;
    transition: border-color .25s ease, box-shadow .25s ease;
  }
  .host-row:hover{ border-color: var(--wag-pink); box-shadow: 0 16px 40px rgba(255,22,200,.14); }
  .host-row picture{ display:block; border-radius: var(--radius-lg); overflow:hidden; aspect-ratio: 4/5; }
  .host-row img{ width:100%; height:100%; object-fit:cover; object-position: top center; }
  .host-role{
    font-family: var(--font-display); text-transform:uppercase; letter-spacing:.05em;
    font-size:.78rem; font-weight:700; color: var(--wag-green);
  }
  .host-row h2{ font-size:1.8rem; margin:.15em 0 .4em; }
  .host-row p{ font-size:1rem; max-width:56ch; margin-bottom:.8em; }
  .host-profile-link{ color: var(--wag-pink); font-weight:600; font-size:.92rem; }

  .hosts-cta{ padding: 8px 0 32px; border-top:1px solid var(--line); padding-top:32px; }
  .hosts-cta p{ font-size:1rem; margin:0; }
  .hosts-cta a{ color: var(--wag-green); font-weight:600; text-decoration:underline; }

  .join{ padding: 8px 0 72px; }
  .join-inner{
    padding:44px 40px; border-radius: var(--radius-lg); text-align:center;
    display:flex; flex-direction:column; align-items:center; gap:14px;
    position:relative;
    background:
      linear-gradient(var(--bg), var(--bg)) padding-box,
      linear-gradient(120deg, var(--wag-pink), var(--wag-green)) border-box;
    border: 2px solid transparent;
  }
  .join-inner h2{ font-size: clamp(1.4rem, 2.8vw, 2rem); margin:0; }
  .join-inner p{ max-width:52ch; margin:0; }

  @media (max-width: 640px){
    .host-row{ grid-template-columns:1fr; }
    .host-row picture{ max-width:220px; }
  }
</style>
