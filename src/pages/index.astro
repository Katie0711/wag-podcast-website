<script>
  document.querySelectorAll<HTMLButtonElement>(".shelf-arrow").forEach((btn) => {
    btn.addEventListener("click", () => {
      const row = document.getElementById(btn.dataset.scrollTarget || "");
      const dir = Number(btn.dataset.dir || "1");
      row?.scrollBy({ left: dir * 440, behavior: "smooth" });
    });
  });
</script>
