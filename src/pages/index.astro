---
import BaseLayout from "../layouts/BaseLayout.astro";
import EqBars from "../components/EqBars.astro";
import Marquee from "../components/Marquee.astro";
import LatestContent from "../components/LatestContent.astro";
import { insiderHref } from "../lib/insiderLink";
import { getCollection } from "astro:content";

const tickerItems = [
  "New Episodes Every Week",
  "Squad Dares",
  "Tell Me the Truth",
  "He Said What?!",
  "3-Second Roast",
  "Watch on YouTube, Spotify & Apple Podcasts",
];

// Real, currently-latest episode -- resolved fresh on every build, never
// hand-typed. Powers the LatestContent module below. Excludes anything
// scheduled with a future publishDate, so an episode written ahead of its
// real release doesn't briefly appear live as "the latest" the moment
// it's deployed.
const [latestEpisode] = (await getCollection("episodes"))
  .filter((e) => e.data.publishDate.valueOf() <= Date.now())
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());

const hosts = [
  { name: "Annabella", role: "The Wild Card", photo: "/images/annabella-thumb.jpg", photoWebp: "/images/annabella-thumb.webp" },
  { name: "Scarlett", role: "The Quick-Witted Instigator", photo: "/images/scarlett-thumb.jpg", photoWebp: "/images/scarlett-thumb.webp" },
  { name: "Angelina", role: "The Voice of Reason", photo: "/images/angelina-thumb.jpg", photoWebp: "/images/angelina-thumb.webp" },
];

// Real recurring segment names, from WAG's own podcast sponsor deck --
// not invented placeholder segment names.
const segments = [
  { name: "Squad Dares", desc: "One dares, the others must do it." },
  { name: "Tell Me the Truth", desc: "No dodging, no lying." },
  { name: "He Said What?!", desc: "Real reactions to what the boys said." },
  { name: "3-Second Roast", desc: "One-liner burns in under 3 seconds." },
];

// Explore section, streaming-shelf redesign (approved 2026-08-02). Each
// category's art is a real photo: a real flagship episode thumbnail where
// one clearly exists, or the same real studio photo already used as that
// page's own ogImage where it doesn't (Why Video-First, Segments, FAQ).
// Hero picks Guys Answer Questions -- the strongest real evidenced search
// demand found in this session's SEO audit, not an arbitrary choice.
const EXPLORE_ICONS: Record<string, string> = {
  guys: `<svg viewBox="0 0 48 48" fill="none"><path d="M6 10a4 4 0 0 1 4-4h28a4 4 0 0 1 4 4v18a4 4 0 0 1-4 4H20l-9 8v-8h-1a4 4 0 0 1-4-4V10Z" fill="currentColor"/><text x="24" y="27" font-family="Khand,Arial" font-weight="700" font-size="20" fill="#08080C" text-anchor="middle">?</text></svg>`,
  mental: `<svg viewBox="0 0 48 48" fill="none"><circle cx="18" cy="20" r="12.5" fill="currentColor" opacity=".5"/><circle cx="30" cy="26" r="12.5" fill="currentColor"/><circle cx="26" cy="26" r="2" fill="#08080C"/><circle cx="32" cy="26" r="2" fill="#08080C"/></svg>`,
  games: `<svg viewBox="0 0 48 48" fill="none"><rect x="4" y="15" width="40" height="21" rx="10.5" fill="currentColor"/><rect x="19" y="20.5" width="3" height="10" rx="1.2" fill="#08080C"/><rect x="15.5" y="24.5" width="10" height="3" rx="1.2" fill="#08080C"/><circle cx="36" cy="21.5" r="2.6" fill="#08080C"/><circle cx="30.5" cy="27" r="2.6" fill="#08080C"/></svg>`,
  growing: `<svg viewBox="0 0 48 48" fill="none"><path d="M24 6 44 16 24 26 4 16 24 6Z" fill="currentColor"/><path d="M13 20v10c0 3.5 5 6.5 11 6.5s11-3 11-6.5V20" stroke="currentColor" stroke-width="3" fill="none" stroke-linecap="round"/><line x1="42" y1="16" x2="42" y2="31" stroke="currentColor" stroke-width="3" stroke-linecap="round"/></svg>`,
  comedy: `<svg viewBox="0 0 48 48" fill="none"><circle cx="24" cy="24" r="19" fill="currentColor"/><circle cx="17" cy="21" r="2.7" fill="#08080C"/><circle cx="31" cy="21" r="2.7" fill="#08080C"/><path d="M13.5 28.5c3 5.5 8.5 9 10.5 9s7.5-3.5 10.5-9" stroke="#08080C" stroke-width="3.2" fill="none" stroke-linecap="round"/></svg>`,
  video: `<svg viewBox="0 0 48 48" fill="none"><circle cx="24" cy="24" r="19" fill="currentColor"/><path d="M20 16 32.5 24 20 32V16Z" fill="#08080C"/></svg>`,
  segments: `<svg viewBox="0 0 48 48" fill="none"><rect x="6" y="17" width="36" height="25" rx="4.5" fill="currentColor"/><path d="M6 23h36" stroke="#08080C" stroke-width="3"/><path d="M10.5 17 16 8h7l-5.5 9h-7Z" fill="#08080C"/><path d="M23.5 17 29 8h7l-5.5 9h-7Z" fill="#08080C"/></svg>`,
  faq: `<svg viewBox="0 0 48 48" fill="none"><circle cx="24" cy="24" r="19" fill="currentColor"/><text x="24" y="32" font-family="Khand,Arial" font-weight="700" font-size="25" fill="#08080C" text-anchor="middle">?</text></svg>`,
  predicted: `<svg viewBox="0 0 48 48" fill="none"><circle cx="24" cy="19" r="13.5" fill="currentColor" opacity=".92"/><ellipse cx="19.5" cy="14.5" rx="4" ry="2.6" fill="#fff" opacity=".55"/><path d="M13 38.5c0-4.3 4.9-6.5 11-6.5s11 2.2 11 6.5" fill="currentColor"/></svg>`,
};

const EXPLORE_CATS = [
  { key: "guys", name: "Guys Answer Questions", hook: "The questions your group chat always asks. Now on camera.", href: "/guys-answer-questions/", photo: "https://img.youtube.com/vi/UlOMu3Aql3Y/mqdefault.jpg", accent: "var(--wag-pink)", tag: "Format" },
  { key: "mental", name: "Teen Mental Health, Real Talk", hook: "What actually helps, from teens who've actually been there.", href: "/mental-health/", photo: "https://img.youtube.com/vi/LjuXuymi-LY/mqdefault.jpg", accent: "var(--wag-green)", tag: "Real Talk" },
  { key: "games", name: "WAG Podcast Games", hook: "The games that turn every episode into chaos.", href: "/games/", photo: "https://img.youtube.com/vi/IJu1eGaUSqA/mqdefault.jpg", accent: "var(--wag-pink)", tag: "Games" },
  { key: "growing", name: "Growing Up Stories", hook: "Suspended. Grounded. Prom disasters. All real.", href: "/topics/growing-up/", photo: "https://img.youtube.com/vi/rmSz8UwXCKM/mqdefault.jpg", accent: "var(--wag-green)", tag: "Stories" },
  { key: "comedy", name: "Teen Comedy Podcast", hook: "Dares, roasts, hot takes — this is the funny stuff.", href: "/teen-comedy-podcast/", photo: "https://img.youtube.com/vi/gweZmPb3r3M/mqdefault.jpg", accent: "var(--wag-pink)", tag: "Comedy" },
  { key: "video", name: "Why Video-First", hook: "Why we film everything instead of just talking.", href: "/video-podcasts-for-teens/", photo: "/images/studio/wag-studio-416.jpg", accent: "var(--wag-green)", tag: "About" },
  { key: "segments", name: "Recurring Segments", hook: "The bits fans wait for, finally explained.", href: "/segments/", photo: "/images/studio/wag-studio-53.jpg", accent: "var(--wag-pink)", tag: "Format" },
  { key: "faq", name: "FAQ", hook: "Everything you're wondering, answered fast.", href: "/faq/", photo: "/images/studio/wag-studio-191.jpg", accent: "var(--wag-green)", tag: "Info" },
  { key: "predicted", name: "WAG Predicted It", hook: "Did they call it? Go find out.", href: "/wag-predicted-it/", photo: "https://img.youtube.com/vi/ko8HDrQp7LQ/mqdefault.jpg", accent: "var(--wag-pink)", tag: "Recap" },
];

// Two even shelves of 4 -- "guys" is the hero above and intentionally not
// repeated below; all other 8 real categories are split evenly so both
// rows fill the same width instead of the uneven 3/2/3 the first pass had.
const EXPLORE_SHELVES = [
  { title: "Formats & Games", tag: "Fan Favorites", items: ["segments", "comedy", "games", "predicted"] },
  { title: "Real Talk & Info", tag: "Good to Know", items: ["mental", "growing", "video", "faq"] },
];
const exploreHero = EXPLORE_CATS.find((c) => c.key === "guys")!;

// Real ItemList schema for the Explore section -- every entry is a real,
// live page on this site, in the same order as the section renders.
const exploreOrder = [exploreHero.key, ...EXPLORE_SHELVES.flatMap((s) => s.items)];
const exploreListSchema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: "Explore WAG Podcast",
  itemListElement: exploreOrder.map((key, i) => {
    const c = EXPLORE_CATS.find((x) => x.key === key)!;
    return { "@type": "ListItem", position: i + 1, name: c.name, url: `https://thewagpodcast.com${c.href}` };
  }),
};
---

<BaseLayout
  title="WAG Podcast | Teen Comedy Podcast by The Wild Adventure Girls"
  description="WAG Podcast: teen comedy video podcast from The Wild Adventure Girls. Angelina, Annabella, and Scarlett — real conversations you won't find anywhere else."
  ogImage="/images/studio/wag-studio-94.jpg"
>
  <!-- What it is -->
  <section class="hero">
    <div class="hero-photo">
      <picture>
        <source srcset="/images/studio/wag-studio-195.webp" type="image/webp" />
        <img src="/images/studio/wag-studio-195.jpg" alt="Angelina, Scarlett, and Annabella on the WAG Podcast set" fetchpriority="high" />
      </picture>
      <div class="hero-scrim"></div>
      <div class="hero-glow" aria-hidden="true"></div>
      <a class="hero-sponsor-badge" href="/sponsor/">Brands partner with us in this studio →</a>
    </div>
    <div class="container hero-inner">
      <p class="eyebrow"><EqBars size="sm" /> Live from the WAG Podcast studio</p>
      <h1>It feels like your <span class="text-accent">group chat</span> — except a lot of people are watching.</h1>
      <p class="lede">A weekly video podcast hosted by three teen girls who don't hold back — trending topics, real conversations, and unscripted chaos, filmed in their own studio.</p>
      <p class="official-note">The official website of WAG Podcast, from The Wild Adventure Girls.</p>
      <div class="hero-actions">
        <a class="btn btn-accent" href="/watch/">Watch an Episode →</a>
        <a class="btn btn-outline" href="/listen/">Listen →</a>
      </div>
    </div>
  </section>

  {latestEpisode && (
    <LatestContent
      image={latestEpisode.data.heroImage}
      imageFallback={latestEpisode.data.heroImage.replace("maxresdefault", "hqdefault")}
      imageAlt={latestEpisode.data.title}
      itemTitle={latestEpisode.data.title}
      itemHref={`/episodes/${latestEpisode.id}/`}
      date={latestEpisode.data.publishDate}
      headline="This is what your group chat's going to be about tomorrow."
      primaryLine="Every face. Every reaction. Nothing cut."
      primaryHref="https://www.youtube.com/@WAGPodcast"
      support={[
        { icon: "spotify", platform: "Spotify", ctaLabel: "Listen on Spotify →", benefit: "No screen required — perfect for the car, the gym, or the walk home.", href: "https://open.spotify.com/show/3tl7szlcJ5eFDqS7cbw6Kb" },
        { icon: "apple", platform: "Apple Podcasts", ctaLabel: "Listen on Apple Podcasts →", benefit: "Drops in your queue the second it's out — no need to remember.", href: "https://podcasts.apple.com/us/podcast/wag-podcast/id1856707489" },
      ]}
      proofLine="New episodes every week — from the team behind a 1.2M+ subscriber world."
    />
  )}

  <Marquee items={tickerItems} />

  <!-- Who it's for -->
  <section class="who-for">
    <div class="container" data-reveal>
      <p class="who-for-text">Made for a teen audience, by teens — not a general talk show with a teen panel bolted on. Most podcasts for teens are adults talking about teens; this is one of the few actually run by them.</p>
    </div>
  </section>

  <!-- Hosts -->
  <section class="hosts-strip">
    <div class="container" data-reveal="stagger">
      <p class="eyebrow">Three Personalities. Zero Filter.</p>
      <div class="hosts-grid">
        {hosts.map((h) => (
          <a class="host-card" href="/hosts/">
            <picture>
              <source srcset={h.photoWebp} type="image/webp" />
              <img src={h.photo} alt={h.name} loading="lazy" />
            </picture>
            <div class="host-card-body">
              <h3>{h.name}</h3>
              <p>{h.role}</p>
            </div>
          </a>
        ))}
      </div>
      <a class="hosts-link" href="/hosts/">Meet the hosts →</a>
    </div>
  </section>

  <!-- Why it's different -->
  <section class="why-different">
    <div class="container" data-reveal="stagger">
      <div class="diff-card">
        <h2>Actually hosted by teens</h2>
        <p>Not adults performing a teen voice — real teen girls, talking the way they actually talk.</p>
      </div>
      <div class="diff-card">
        <h2>Video, not just audio</h2>
        <p>Filmed weekly in their own studio and posted to YouTube — you see the reactions, not just hear them.</p>
      </div>
      <div class="diff-card">
        <h2>Unscripted, every week</h2>
        <p>No writers' room. Real conversation, real fan questions, real dares — new episode, new chaos.</p>
      </div>
    </div>
  </section>

  <!-- Recurring segments -->
  <section class="segments">
    <div class="container" data-reveal="stagger">
      <p class="eyebrow"><EqBars size="sm" /> Every Episode</p>
      <h2>The segments fans actually wait for.</h2>
      <div class="segments-grid">
        {segments.map((s) => (
          <div class="segment-card">
            <EqBars size="sm" />
            <h3>{s.name}</h3>
            <p>{s.desc}</p>
          </div>
        ))}
      </div>
      <a class="segments-link" href="/segments/">See all the segments →</a>
    </div>
  </section>

  <!-- Watch/Listen -->
  <section class="watch-listen">
    <div class="container" data-reveal>
      <h2>Ready to actually watch one?</h2>
      <div class="wl-actions">
        <a class="btn btn-accent" href="/watch/">Watch Now →</a>
        <a class="btn btn-outline" href="/listen/">Listen Now →</a>
      </div>
    </div>
  </section>

  <!-- Explore -->
  <section class="explore">
    <script type="application/ld+json" set:html={JSON.stringify(exploreListSchema)} />
    <div class="container" data-reveal="stagger">
      <p class="eyebrow"><EqBars size="sm" /> Explore WAG Podcast</p>
      <h2 class="sr-only">Explore WAG Podcast: formats, games, and topics</h2>

      <a class="explore-hero" href={exploreHero.href}>
        <div class="explore-hero-text">
          <span class="explore-hero-badge">★ Fan Favorite</span>
          <h3>{exploreHero.name}</h3>
          <div class="explore-hero-underline"></div>
          <p>{exploreHero.hook}</p>
          <span class="explore-hero-cta">Explore the Format →</span>
        </div>
        <div class="explore-hero-photo">
          <img src={exploreHero.photo.replace("mqdefault", "hqdefault")} alt={`${exploreHero.name} — WAG Podcast`} loading="lazy" />
        </div>
      </a>

      {EXPLORE_SHELVES.map((shelf, si) => (
        <div class="explore-shelf">
          <div class="explore-shelf-head">
            <h3>{shelf.title}</h3>
            <div class="shelf-controls">
              <span>{shelf.tag}</span>
              <button class="shelf-arrow" data-scroll-target={`explore-row-${si}`} data-dir="-1" aria-label="Scroll left">‹</button>
              <button class="shelf-arrow" data-scroll-target={`explore-row-${si}`} data-dir="1" aria-label="Scroll right">›</button>
            </div>
          </div>
          <div class="explore-row" id={`explore-row-${si}`}>
            {shelf.items.map((key) => {
              const c = EXPLORE_CATS.find((x) => x.key === key)!;
              return (
                <a class="explore-poster" href={c.href}>
                  <div class="explore-poster-accent" style={`background:linear-gradient(90deg,${c.accent},transparent 160%)`} />
                  <div class="explore-poster-art">
                    <img src={c.photo} alt={c.name} loading="lazy" />
                    <span class="explore-poster-tag">{c.tag}</span>
                    <div class="explore-poster-icon" style={`background:${c.accent}`} set:html={EXPLORE_ICONS[c.key]} />
                    <div class="explore-poster-play">▶</div>
                  </div>
                  <div class="explore-poster-body"><h4>{c.name}</h4><p>{c.hook}</p></div>
                </a>
              );
            })}
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Join -->
  <section class="join">
    <div class="container register-light join-inner" data-reveal>
      <h2>Never miss a new episode.</h2>
      <p>Join WAG Insider for new-episode alerts and behind-the-scenes extras — the same free list the main WAG site uses, one signup for everything WAG.</p>
      <a class="btn btn-primary" href={insiderHref("home")}>Join WAG Insider →</a>
    </div>
  </section>

  <section class="cross-link">
    <div class="container">
      <p>WAG Podcast is one part of <a href="https://wildadventuregirls.com/">The Wild Adventure Girls</a> — adventure, mystery investigations, and challenge content live on the main site.</p>
    </div>
  </section>
</BaseLayout>

<style>
  .hero{ position:relative; padding: 0 0 0; }
  .hero-photo{ position:relative; width:100%; aspect-ratio: 2.4/1; overflow:hidden; margin-bottom:44px; }
  .hero-photo img{ width:100%; height:100%; object-fit:cover; object-position: center 25%; display:block; }
  .hero-scrim{ position:absolute; inset:0; background: linear-gradient(0deg, rgba(10,10,15,.82) 0%, rgba(10,10,15,.15) 55%, transparent 75%); }
  .hero-glow{
    position:absolute; inset:0; pointer-events:none; mix-blend-mode:screen; opacity:.5;
    background:
      radial-gradient(ellipse 40% 55% at 8% 100%, var(--wag-pink) 0%, transparent 70%),
      radial-gradient(ellipse 35% 50% at 100% 100%, var(--wag-green) 0%, transparent 70%);
  }
  /* Same rotated-badge language as the Sponsor page's cta-photo-badge --
     turns the fact that both pages are shot in the same real studio into
     a deliberate cross-link instead of an accidental-looking repeat. */
  .hero-sponsor-badge{
    position:absolute; z-index:2; right:20px; bottom:20px; max-width:220px;
    background: var(--wag-pink); color:#fff; border-radius: var(--radius-sm);
    padding:.85em 1.1em; font-family: var(--font-display); text-transform:uppercase;
    letter-spacing:.02em; font-weight:700; font-size:.85rem; line-height:1.3;
    box-shadow: var(--shadow-sm); transform: rotate(-2deg);
    transition: transform .15s ease;
  }
  .hero-sponsor-badge:hover{ transform: rotate(-2deg) translateY(-2px); }
  .hero-inner{ max-width:68ch; padding-bottom:56px; }
  .eyebrow{ display:inline-flex; align-items:center; gap:10px; }
  .hero h1{ font-size: clamp(2.1rem, 4.4vw, 3.4rem); max-width:20ch; margin-bottom:.35em; }
  .text-accent{
    background: linear-gradient(90deg, var(--wag-pink) 0%, var(--wag-green) 100%);
    -webkit-background-clip:text; background-clip:text; color:transparent;
  }
  .lede{ font-size:1.15rem; max-width:60ch; margin-bottom:.5em; }
  .official-note{ font-size:.92rem; color: var(--ink-muted); margin-bottom:1.4em; }
  .hero-actions{ display:flex; gap:16px; flex-wrap:wrap; }
  .btn-outline{ border-color: var(--ink); }
  .btn-outline:hover{ background: var(--ink); color: var(--bg); }

  .who-for{ padding: 40px 0 56px; }
  .who-for-text{ font-size:1.25rem; max-width:52ch; color: var(--ink-soft); font-weight:500; }

  .hosts-strip{ padding: 0 0 64px; }
  .hosts-grid{ display:grid; grid-template-columns: repeat(3, 1fr); gap:22px; margin:20px 0; }
  .host-card{
    display:block; border-radius: var(--radius); overflow:hidden; border:1px solid var(--line);
    transition: transform .22s ease, box-shadow .22s ease, border-color .22s ease;
  }
  .host-card:hover{ transform: translateY(-4px); box-shadow: 0 16px 40px rgba(255,22,200,.22); border-color: var(--wag-pink); }
  .host-card picture{ display:block; aspect-ratio: 4/5; }
  .host-card img{ width:100%; height:100%; object-fit:cover; object-position: top center; }
  .host-card-body{ padding:16px 18px; }
  .host-card h3{ font-size:1.1rem; margin:0 0 .2em; }
  .host-card-body p{ font-size:.85rem; color: var(--ink-muted); margin:0; }
  .hosts-link{ color: var(--wag-green); font-weight:600; }

  .why-different{ padding: 24px 0 64px; border-top:1px solid var(--line); }
  .why-different .container{ display:grid; grid-template-columns: repeat(3, 1fr); gap:20px; }
  .diff-card{
    padding:22px 24px; border-radius: var(--radius); border:1px solid var(--line); background: var(--bg-alt);
    transition: border-color .2s ease, transform .2s ease;
  }
  .diff-card:hover{ border-color: var(--wag-green); transform: translateY(-2px); }
  .diff-card h2{ font-size:1.05rem; margin-bottom:.5em; }
  .diff-card p{ font-size:.9rem; margin:0; }

  .segments{ padding: 24px 0 64px; border-top:1px solid var(--line); }
  .segments h2{ font-size: clamp(1.5rem, 3vw, 2.1rem); max-width:20ch; margin-bottom:.8em; }
  .segments-grid{ display:grid; grid-template-columns: repeat(4, 1fr); gap:18px; }
  .segment-card{
    padding:20px 22px; border-radius: var(--radius); border:1px solid var(--line);
    background: var(--bg-alt); transition: border-color .2s ease, box-shadow .2s ease;
    display:flex; flex-direction:column; gap:10px;
  }
  .segment-card:hover{ border-color: var(--wag-pink); box-shadow: 0 12px 28px rgba(255,22,200,.16); }
  .segment-card h3{
    font-family: var(--font-display); text-transform:uppercase; letter-spacing:.02em;
    font-size:1.05rem; color: var(--wag-pink); margin:0;
  }
  .segment-card p{ font-size:.86rem; margin:0; color: var(--ink-muted); }
  .segments-link{ display:inline-block; margin-top:24px; font-weight:600; font-size:.94rem; color: var(--wag-green); }

  .watch-listen{ padding: 24px 0 56px; text-align:center; border-top:1px solid var(--line); }
  .watch-listen h2{ font-size: clamp(1.5rem, 3vw, 2.1rem); margin-bottom:.6em; }
  .wl-actions{ display:flex; gap:16px; justify-content:center; flex-wrap:wrap; margin-bottom:0; }

  .explore{ padding: 24px 0 8px; border-top:1px solid var(--line); padding-top:48px; }
  .explore .eyebrow{ margin-bottom:20px; }

  .explore-hero{
    position:relative; display:grid; grid-template-columns: 1.15fr 1fr; align-items:stretch;
    border-radius: var(--radius-lg); overflow:hidden; min-height:260px;
    border:1px solid var(--line); text-decoration:none; color:inherit; margin-bottom:32px;
    background: linear-gradient(160deg,#1c1030,var(--bg-alt) 75%);
    box-shadow: 0 20px 50px -14px rgba(0,0,0,.6);
  }
  .explore-hero-text{
    position:relative; z-index:1; padding:34px 38px; display:flex; flex-direction:column; justify-content:center;
  }
  .explore-hero-badge{
    align-self:flex-start;
    font-family: var(--font-display); font-weight:600; text-transform:uppercase; font-size:.76rem;
    letter-spacing:.08em; color:#0A0A0F; background:var(--wag-green); padding:6px 14px; border-radius:999px;
    margin-bottom:16px;
  }
  .explore-hero-text h3{
