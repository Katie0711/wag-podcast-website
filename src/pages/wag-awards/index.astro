---
// Fifth production interaction: the start of a real recurring annual/
// seasonal franchise, deliberately scoped small and honest rather than
// padded with invented categories. WAG has real nominatable content for
// exactly one category so far -- two real Guys Answer Questions guests,
// Ryan and Aiden -- so "WAG Awards: Season 1" ships with that one real
// category. More categories get added as WAG creates more real
// nominatable content (more guests, more distinct challenges, etc.),
// not invented now to make the page feel bigger. Same restraint as the
// favorite-segment correction: real content only, never a fabricated
// list to fill space.
export const prerender = false;

import { getStore } from "@netlify/blobs";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import EqBars from "../../components/EqBars.astro";
import PollWidget from "../../components/PollWidget.astro";
import ConsentCheckboxPair from "../../components/ConsentCheckboxPair.astro";
import SponsorSlot from "../../components/SponsorSlot.astro";
import WhatsNext from "../../components/WhatsNext.astro";

const POLL_KEY = "awards-favorite-guest";
const options = [
  { key: "ryan", label: "Ryan" },
  { key: "aiden", label: "Aiden" },
];

// Real guest context -- lifted from the same source-of-truth
// installments array in /guys-answer-questions/, not duplicated data,
// just the subset needed to make each nominee feel like a real person
// with a real episode instead of a bare name in a poll button.
const nominees = [
  { key: "ryan", name: "Ryan", videoId: "UlOMu3Aql3Y", url: "https://wildadventuregirls.com/podcast/episodes/questions-girls-want-to-ask-guys-ulomu3aql3y", tagline: "Installment 1 — answered the questions every girl secretly wants to ask." },
  { key: "aiden", name: "Aiden", videoId: "7ajsKON59TA", url: "/episodes/guys-answer-questions-what-guys-never-say-out-loud/", tagline: "Installment 2 — answered the questions girls are too afraid to ask." },
];

const store = getStore("wag-poll-votes");
const initialCounts = ((await store.get(POLL_KEY, { type: "json" })) as Record<string, number> | null) ?? {};

const faqs = [
  { q: "What is WAG Awards?", a: "WAG's real, ongoing fan-voted awards — starting with one category and growing as the show creates more real content to nominate." },
  { q: "Why is there only one category?", a: "Because that's what WAG actually has real nominees for right now. More categories launch as real content exists for them — not before." },
  { q: "Who are Ryan and Aiden?", a: "The two real guys who've appeared on Guys Answer Questions so far — see the full format page to watch both installments." },
];

const pageSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: "WAG Awards — WAG Podcast",
  description: "WAG's real, fan-voted awards. Season 1 category: Favorite Guest — Ryan vs Aiden.",
  image: "https://img.youtube.com/vi/UlOMu3Aql3Y/mqdefault.jpg",
  author: { "@type": "Organization", name: "WAG Podcast" },
  publisher: { "@type": "Organization", name: "The Wild Adventure Girls", url: "https://wildadventuregirls.com" },
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
};
---

<BaseLayout
  title="WAG Awards — Vote for Your Favorite Guest | WAG Podcast"
  description="WAG's real, fan-voted awards. Season 1 category: Favorite Guest — Ryan vs Aiden from Guys Answer Questions."
  ogImage="/images/studio/wag-studio-301.jpg"
>
  <script type="application/ld+json" set:html={JSON.stringify(pageSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <section class="awards-hero">
    <div class="container" data-reveal>
      <Breadcrumb items={[{ label: "Home", href: "/" }, { label: "WAG Awards", href: "/wag-awards/" }]} />
      <p class="eyebrow"><EqBars size="sm" /> WAG Awards — Season 1</p>
      <h1>Vote for your <span class="text-accent">favorite guest.</span></h1>
      <p class="lede">WAG's first real fan-voted award. One category to start — more launch as the show creates more real content to nominate.</p>
    </div>
  </section>

  <section class="awards-nominees">
    <div class="container container--narrow" data-reveal="stagger">
      <p class="category-label">Category: Favorite Guest</p>
      <div class="nominee-grid">
        {nominees.map((n) => (
          <a class="nominee-card" href={n.url}>
            <div class="nominee-photo">
              <img src={`https://img.youtube.com/vi/${n.videoId}/mqdefault.jpg`} alt={n.name} loading="lazy" />
            </div>
            <div class="nominee-body">
              <h3>{n.name}</h3>
              <p>{n.tagline}</p>
              <span class="nominee-link">Watch the episode →</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="awards-poll">
    <div class="container container--narrow" data-reveal>
      <PollWidget pollKey={POLL_KEY} question="Favorite Guys Answer Questions guest?" options={options} initialCounts={initialCounts} />
      <ConsentCheckboxPair
        voteKey={POLL_KEY}
        transactionalLabel="Email me when a new WAG Awards category launches"
        marketingLabel="Also join WAG Insider for future polls, quizzes, episodes, and product news"
        apiEndpoint="/api/interaction-consent"
        transactionalTag="wag-awards"
      />
    </div>
  </section>

  <section class="awards-sponsor">
    <div class="container container--narrow" data-reveal>
      <SponsorSlot
        fallbackHref="/guys-answer-questions/"
        fallbackLabel="🎬 Watch both real Guys Answer Questions installments"
      />
    </div>
  </section>

  <section class="awards-how">
    <div class="container container--narrow" data-reveal>
      <h2>About WAG Awards</h2>
      <div class="faq-list">
        {faqs.map((f) => (
          <div class="faq-item">
            <h3>{f.q}</h3>
            <p>{f.a}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <WhatsNext
    items={[
      { icon: "❓", label: "Guys Answer Questions", href: "/guys-answer-questions/" },
      { icon: "💭", label: "Submit a question for a future episode", href: "/questions-featured/" },
      { icon: "🎬", label: "Vote for your favorite segment", href: "/favorite-segment/" },
    ]}
    shareUrl="https://thewagpodcast.com/wag-awards/"
    shareTitle="WAG Awards — WAG Podcast"
    insiderPage="wag-awards"
  />
</BaseLayout>

<style>
  .awards-hero { padding: 32px 0 20px; }
  .eyebrow { display: inline-flex; align-items: center; gap: 10px; color: var(--wag-green); margin-top: 14px; }
  .awards-hero h1 { font-size: clamp(2rem, 4.2vw, 3.1rem); max-width: 22ch; }
  .text-accent {
    background: linear-gradient(90deg, var(--wag-pink) 0%, var(--wag-green) 100%);
    -webkit-background-clip: text; background-clip: text; color: transparent;
  }
  .lede { font-size: 1.05rem; max-width: 60ch; color: var(--ink-soft); }

  .container--narrow { max-width: 680px; }

  .awards-nominees { padding: 8px 0 28px; }
  .category-label {
    font-family: var(--font-display); text-transform: uppercase; letter-spacing: .06em;
    font-size: .78rem; color: var(--wag-pink); margin: 0 0 14px;
  }
  .nominee-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
  .nominee-card {
    display: block; border-radius: var(--radius-lg); overflow: hidden; border: 1px solid var(--line);
    background: var(--bg-alt); text-decoration: none; color: inherit;
    transition: transform .2s ease, box-shadow .2s ease, border-color .2s ease;
  }
  .nominee-card:hover { transform: translateY(-3px); box-shadow: 0 16px 36px rgba(255,22,200,.16); border-color: var(--wag-pink); }
  .nominee-photo { aspect-ratio: 16/9; overflow: hidden; }
  .nominee-photo img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .nominee-body { padding: 16px 18px 20px; }
  .nominee-body h3 { font-size: 1.15rem; margin: 0 0 6px; }
  .nominee-body p { font-size: .84rem; color: var(--ink-soft); margin: 0 0 12px; line-height: 1.4; }
  .nominee-link { font-weight: 600; font-size: .82rem; color: var(--wag-green); }

  @media (max-width: 560px) {
    .nominee-grid { grid-template-columns: 1fr; }
  }

  .awards-poll { padding: 12px 0 24px; }
  .awards-sponsor { padding: 0 0 32px; }

  .awards-how { padding: 12px 0 40px; }
  .awards-how h2 { font-size: 1.5rem; margin-bottom: 18px; }
  .faq-list { display: flex; flex-direction: column; gap: 18px; }
  .faq-item h3 { font-family: var(--font-body); font-weight: 700; text-transform: none; letter-spacing: 0; font-size: 1rem; margin-bottom: 6px; }
  .faq-item p { font-size: .92rem; color: var(--ink-soft); margin: 0; }
</style>
