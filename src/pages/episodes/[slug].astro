---
import BaseLayout from "../../layouts/BaseLayout.astro";
import EqBars from "../../components/EqBars.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import PlatformBar from "../../components/PlatformBar.astro";
import WhatsNext from "../../components/WhatsNext.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const entries = await getCollection("episodes");
  return entries.map((e) => ({ params: { slug: e.id }, props: { entry: e } }));
}

const { entry } = Astro.props as { entry: Awaited<ReturnType<typeof getCollection<"episodes">>>[number] };
const { Content } = await render(entry);
const dateFmt = new Intl.DateTimeFormat("en-US", { month: "long", day: "numeric", year: "numeric" });

const hostNames: Record<string, string> = { angelina: "Angelina", scarlett: "Scarlett", annabella: "Annabella" };
const hostList = entry.data.hosts.map((h) => hostNames[h]);
const hostLabel = hostList.length > 1
  ? `${hostList.slice(0, -1).join(", ")} & ${hostList[hostList.length - 1]}`
  : hostList[0];

// PodcastEpisode, not VideoObject -- the real schema.org type for a
// podcast episode, and it's what ties this page's entity graph back to
// the show (partOfSeries) and its real hosts (actor), matching the
// PodcastSeries @id already declared in BaseLayout.astro. timeRequired
// only appears when a real, verified runtime exists -- never guessed.
const episodeSchema = {
  "@context": "https://schema.org",
  "@type": "PodcastEpisode",
  name: entry.data.title,
  description: entry.data.description,
  datePublished: entry.data.publishDate.toISOString(),
  url: `https://thewagpodcast.com/episodes/${entry.id}/`,
  image: entry.data.heroImage,
  ...(entry.data.durationSeconds ? { timeRequired: `PT${entry.data.durationSeconds}S` } : {}),
  partOfSeries: { "@type": "PodcastSeries", "@id": "https://thewagpodcast.com/#podcast", name: "WAG Podcast" },
  actor: hostList.map((name) => ({ "@type": "Person", name })),
  associatedMedia: {
    "@type": "VideoObject",
    name: entry.data.title,
    description: entry.data.description,
    uploadDate: entry.data.publishDate.toISOString(),
    embedUrl: `https://www.youtube.com/embed/${entry.data.videoId}`,
    thumbnailUrl: entry.data.heroImage,
  },
};

// Generated directly from entry.data.faqs -- the exact same array that
// drives the visible "Quick Answers" section below, so schema can never
// drift from what's actually on the page.
const faqSchema = entry.data.faqs.length > 0 ? {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: entry.data.faqs.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
} : null;

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Watch", item: "https://thewagpodcast.com/watch/" },
    { "@type": "ListItem", position: 2, name: entry.data.title, item: `https://thewagpodcast.com/episodes/${entry.id}` },
  ],
};

// Related episodes driven by the real shared `topics` tags -- never a
// manually curated/invented list, so it can't drift out of sync as new
// entries are added. Every episode pages here had only one incoming
// internal link (from /watch/) per the July 2026 Ahrefs audit; this is
// the fix, without inventing any new content.
const allEpisodes = await getCollection("episodes");
const related = allEpisodes
  .filter((e) => e.id !== entry.id && e.data.topics.some((t) => entry.data.topics.includes(t)))
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf())
  .slice(0, 3);

const canonicalUrl = `https://thewagpodcast.com/episodes/${entry.id}/`;

// "What's Next" items -- every entry points at something real: the next
// most-related episode(s) already computed above, the real Games hub when
// this episode's own topics actually include games-challenges (never
// linked when there's no genuine overlap), and the platform links this
// episode actually has (falling back to the show-level ones).
const whatsNextItems = [
  ...related.slice(0, 2).map((r) => ({ icon: "🎬", label: r.data.title, href: `/episodes/${r.id}/` })),
  ...(entry.data.topics.includes("games-challenges")
    ? [{ icon: "😂", label: "Play: WAG Games", href: "/games/" }]
    : []),
];
---

<BaseLayout title={entry.data.metaTitle ?? entry.data.title} description={entry.data.description} ogImage={entry.data.heroImage}>
  <script type="application/ld+json" set:html={JSON.stringify(episodeSchema)} />
  {faqSchema && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

  <article class="episode-page">
    <div class="container">
      <Breadcrumb items={[{ label: "Watch", href: "/watch/" }, { label: entry.data.title, href: `/episodes/${entry.id}/` }]} />

      <div class="episode-header">
        <p class="eyebrow"><EqBars size="sm" /> WAG Podcast Story</p>
        <h1>{entry.data.title}</h1>
        <p class="episode-meta">{dateFmt.format(entry.data.publishDate)} &middot; {hostLabel}</p>
        <div class="episode-platforms">
          <PlatformBar
            spotifyUrl={entry.data.destinations?.spotify}
            appleUrl={entry.data.destinations?.apple}
            showWatch={false}
          />
        </div>
      </div>

      <section class="episode-video" data-reveal>
        <div class="embed-wrap">
          <iframe
            src={`https://www.youtube.com/embed/${entry.data.videoId}`}
            title={entry.data.title}
            loading="lazy"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
            allowfullscreen
          ></iframe>
        </div>
      </section>

      <div class="episode-body">
        <Content />
      </div>

      {entry.data.faqs.length > 0 && (
        <div class="episode-faqs">
          <h2>Quick Answers</h2>
          {entry.data.faqs.map((f) => (
            <div class="faq-item">
              <h3>{f.q}</h3>
              <p>{f.a}</p>
            </div>
          ))}
        </div>
      )}

      {related.length > 0 && (
        <div class="related-episodes">
          <h2>More stories like this</h2>
          <div class="related-grid">
            {related.map((r) => (
              <a class="related-card" href={`/episodes/${r.id}/`}>
                <div class="related-thumb">
                  <img src={r.data.heroImage} alt={r.data.title} loading="lazy" />
                </div>
                <span class="related-title">{r.data.title}</span>
              </a>
            ))}
          </div>
        </div>
      )}
    </div>

    <WhatsNext
      items={whatsNextItems}
      shareUrl={canonicalUrl}
      shareTitle={entry.data.title}
      insiderPage={`episode-${entry.id}`}
    />
  </article>
</BaseLayout>

<style>
  .episode-page{ padding: 40px 0 0; }
  .episode-header{ max-width:74ch; margin: 20px 0 28px; }
  .eyebrow{ display:inline-flex; align-items:center; gap:10px; color: var(--wag-green); font-family: var(--font-display); text-transform:uppercase; letter-spacing:.05em; font-size:.78rem; font-weight:700; margin-bottom:.6em; }
  .episode-header h1{ font-size: clamp(1.9rem, 3.8vw, 2.7rem); margin: 0 0 .4em; max-width:22ch; }
  .episode-meta{ color: var(--ink-muted); font-size:.95rem; margin:0 0 18px; }
  .episode-platforms{ margin-top: 4px; }

  .episode-video{ padding: 0 0 40px; }
  .embed-wrap{
    position:relative; width:100%; aspect-ratio: 16/9; border-radius: var(--radius); overflow:hidden;
    border: 2px solid transparent;
    background:
      linear-gradient(var(--bg), var(--bg)) padding-box,
      linear-gradient(120deg, var(--wag-pink), var(--wag-green)) border-box;
    box-shadow: 0 20px 50px rgba(0,0,0,.4);
  }
  .embed-wrap iframe{ position:absolute; inset:0; width:100%; height:100%; border:0; }

  .episode-body{ max-width:70ch; font-size:1.08rem; margin: 0 auto 40px; }
  .episode-body :global(h2){ font-size:1.3rem; margin: 1.4em 0 .5em; }
  .episode-body :global(h3){ font-size:1.08rem; margin: 1.2em 0 .4em; text-transform:none; letter-spacing:0; font-family: var(--font-body); font-weight:700; color: var(--ink); }
  .episode-body :global(p){ margin-bottom:1.2em; color: var(--ink-soft); }
  .episode-body :global(a){ color: var(--wag-green); font-weight:600; }
  .episode-body :global(blockquote){ margin: 1.4em 0; padding: 4px 0 4px 20px; border-left: 3px solid var(--wag-green); font-style: italic; color: var(--ink); }

  .episode-faqs{ max-width:70ch; margin: 0 auto 48px; border-top:1px solid var(--line); padding-top:32px; }
  .episode-faqs h2{ font-size:1.4rem; margin-bottom:20px; }
  .faq-item{ margin-bottom:20px; }
  .faq-item h3{
    font-family: var(--font-body); font-weight:700; font-size:1.02rem;
    text-transform:none; letter-spacing:0; color: var(--ink); margin-bottom:.4em;
  }
  .faq-item p{ color: var(--ink-soft); font-size:.98rem; margin:0; }

  .related-episodes{ max-width:70ch; margin: 0 auto 48px; border-top:1px solid var(--line); padding-top:32px; }
  .related-episodes h2{ font-size:1.4rem; margin-bottom:20px; }
  .related-grid{ display:grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap:18px; }
  .related-card{
    display:block; border-radius: var(--radius); overflow:hidden; border:1px solid var(--line);
    background: var(--bg-alt); transition: transform .2s ease, border-color .2s ease;
  }
  .related-card:hover{ transform: translateY(-3px); border-color: var(--wag-green); }
  .related-thumb{ aspect-ratio:16/9; overflow:hidden; }
  .related-thumb img{ width:100%; height:100%; object-fit:cover; display:block; }
  .related-title{
    display:block; padding:12px 14px 16px; font-family: var(--font-body); font-weight:700;
    font-size:.92rem; line-height:1.35; color: var(--ink);
  }

</style>
