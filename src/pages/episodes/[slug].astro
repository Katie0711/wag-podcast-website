---
import BaseLayout from "../../layouts/BaseLayout.astro";
import EqBars from "../../components/EqBars.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import { insiderHref } from "../../lib/insiderLink";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const entries = await getCollection("episodes");
  return entries.map((e) => ({ params: { slug: e.id }, props: { entry: e } }));
}

const { entry } = Astro.props as { entry: Awaited<ReturnType<typeof getCollection<"episodes">>>[number] };
const { Content } = await render(entry);
const dateFmt = new Intl.DateTimeFormat("en-US", { month: "long", day: "numeric", year: "numeric" });

const videoSchema = {
  "@context": "https://schema.org",
  "@type": "VideoObject",
  name: entry.data.title,
  description: entry.data.description,
  embedUrl: `https://www.youtube.com/embed/${entry.data.videoId}`,
  thumbnailUrl: entry.data.heroImage,
  uploadDate: entry.data.publishDate.toISOString(),
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Watch", item: "https://thewagpodcast.com/watch/" },
    { "@type": "ListItem", position: 2, name: entry.data.title, item: `https://thewagpodcast.com/episodes/${entry.id}` },
  ],
};
---

<BaseLayout title={entry.data.title} description={entry.data.description} ogImage={entry.data.heroImage}>
  <script type="application/ld+json" set:html={JSON.stringify(videoSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

  <article class="episode-page">
    <div class="container">
      <Breadcrumb items={[{ label: "Watch", href: "/watch/" }, { label: entry.data.title, href: `/episodes/${entry.id}/` }]} />

      <div class="episode-header">
        <p class="eyebrow"><EqBars size="sm" /> WAG Podcast Story</p>
        <h1>{entry.data.title}</h1>
        <p class="episode-meta">{dateFmt.format(entry.data.publishDate)} &middot; Angelina, Scarlett &amp; Annabella</p>
      </div>

      <section class="episode-video" data-reveal>
        <div class="embed-wrap">
          <iframe
            src={`https://www.youtube.com/embed/${entry.data.videoId}`}
            title={entry.data.title}
            loading="lazy"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
            allowfullscreen
          ></iframe>
        </div>
      </section>

      <div class="episode-body">
        <Content />
      </div>
    </div>

    <section class="join">
      <div class="container register-light join-inner" data-reveal>
        <h2>Never miss a new episode.</h2>
        <p>Join WAG Insider for new-episode alerts and behind-the-scenes extras — the same free list the main WAG site uses, one signup for everything WAG.</p>
        <a class="btn btn-primary" href={insiderHref(`episode-${entry.id}`)}>Join WAG Insider →</a>
      </div>
    </section>
  </article>
</BaseLayout>

<style>
  .episode-page{ padding: 40px 0 0; }
  .episode-header{ max-width:74ch; margin: 20px 0 28px; }
  .eyebrow{ display:inline-flex; align-items:center; gap:10px; color: var(--wag-green); font-family: var(--font-display); text-transform:uppercase; letter-spacing:.05em; font-size:.78rem; font-weight:700; margin-bottom:.6em; }
  .episode-header h1{ font-size: clamp(1.9rem, 3.8vw, 2.7rem); margin: 0 0 .4em; max-width:22ch; }
  .episode-meta{ color: var(--ink-muted); font-size:.95rem; margin:0; }

  .episode-video{ padding: 0 0 40px; }
  .embed-wrap{
    position:relative; width:100%; aspect-ratio: 16/9; border-radius: var(--radius); overflow:hidden;
    border: 2px solid transparent;
    background:
      linear-gradient(var(--bg), var(--bg)) padding-box,
      linear-gradient(120deg, var(--wag-pink), var(--wag-green)) border-box;
    box-shadow: 0 20px 50px rgba(0,0,0,.4);
  }
  .embed-wrap iframe{ position:absolute; inset:0; width:100%; height:100%; border:0; }

  .episode-body{ max-width:70ch; font-size:1.08rem; margin: 0 auto 56px; }
  .episode-body :global(h2){ font-size:1.3rem; margin: 1.4em 0 .5em; }
  .episode-body :global(p){ margin-bottom:1.2em; color: var(--ink-soft); }
  .episode-body :global(a){ color: var(--wag-green); font-weight:600; }

  .join{ padding: 8px 0 72px; }
  .join-inner{
    padding:44px 40px; border-radius: var(--radius-lg); text-align:center;
    display:flex; flex-direction:column; align-items:center; gap:14px;
    position:relative;
    background:
      linear-gradient(var(--bg), var(--bg)) padding-box,
      linear-gradient(120deg, var(--wag-pink), var(--wag-green)) border-box;
    border: 2px solid transparent;
  }
  .join-inner h2{ font-size: clamp(1.4rem, 2.8vw, 2rem); margin:0; }
  .join-inner p{ max-width:52ch; margin:0; }
</style>
