---
export const prerender = false;

import { getStore } from "@netlify/blobs";
import BaseLayout from "../../layouts/BaseLayout.astro";
import EqBars from "../../components/EqBars.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import PollWidget from "../../components/PollWidget.astro";
import SponsorSlot from "../../components/SponsorSlot.astro";
import WhatsNext from "../../components/WhatsNext.astro";

// Real, original WAG material -- three real episodes where the hosts
// made actual on-camera predictions. Found via the Phase 2 catalog
// audit; too small a set (3 episodes) to justify its own topic hub, but
// a genuine, distinct thread worth pulling into one page. Still does
// NOT claim to score whether the predictions came true -- that's not
// verified, and each episode already poses that as its own open
// question. What changed in this review pass: each prediction gets a
// real audience-opinion poll ("called it" vs "way off") via the
// existing PollWidget/poll-vote.ts -- honest because it's clearly
// framed as fan opinion, never as a verified real-world outcome. No
// email consent capture here (unlike Verdict/Match/Poll/Questions):
// there's no future reveal to notify anyone about, so a consent step
// would just be friction, not a real hook.
const predictions = [
  {
    title: "Who Gets Their First Kiss This Summer?",
    videoId: "ko8HDrQp7LQ",
    url: "https://wildadventuregirls.com/podcast/episodes/2026-predictions-first-kiss-and-teen-trends-ko8hdrqp7lq",
    blurb: "Real 2026 predictions — first kiss, the trends, what the top YouTubers are doing.",
    pollKey: "predicted-summer-kiss",
  },
  {
    title: "If This Stranger Things Theory Is Right… Will Is Gone",
    videoId: "JfJ6khURkrM",
    url: "https://wildadventuregirls.com/podcast/episodes/will-byers-death-theory-stranger-things-jfj6khurkrm",
    blurb: "A real theory on how Will Byers' story ends in Stranger Things.",
    pollKey: "predicted-will-byers",
  },
  {
    title: "We Predicted The ENDING of STRANGER THINGS!",
    videoId: "dUtZhJS3qu0",
    url: "https://wildadventuregirls.com/podcast/episodes/stranger-things-ending-predictions-dutzhjs3qu0",
    blurb: "The wildest Season 5 theories, called out loud before the finale.",
    pollKey: "predicted-st-ending",
  },
];

const pollOptions = [
  { key: "called-it", label: "🎯 They called it" },
  { key: "way-off", label: "😬 Way off" },
];

const store = getStore("wag-poll-votes");
const pollCounts = Object.fromEntries(
  await Promise.all(
    predictions.map(async (p) => [p.pollKey, ((await store.get(p.pollKey, { type: "json" })) as Record<string, number> | null) ?? {}])
  )
);

const pageSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: "WAG Predicted It — WAG Podcast",
  description: "The real predictions WAG Podcast has made on camera — 2026 trends, a Stranger Things theory, and the show's own Season 5 ending predictions.",
  image: "https://thewagpodcast.com/images/studio/wag-studio-221.jpg",
  author: { "@type": "Organization", name: "WAG Podcast" },
  publisher: { "@type": "Organization", name: "The Wild Adventure Girls", url: "https://wildadventuregirls.com" },
};

const listSchema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: "WAG Predicted It",
  itemListElement: predictions.map((p, i) => ({ "@type": "ListItem", position: i + 1, name: p.title, url: p.url })),
};
---

<BaseLayout
  title="WAG Predicted It — WAG Podcast"
  description="The real predictions WAG Podcast has made on camera — 2026 trends, a Stranger Things theory, and the show's own Season 5 ending predictions."
  ogImage="/images/studio/wag-studio-221.jpg"
>
  <script type="application/ld+json" set:html={JSON.stringify(pageSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(listSchema)} />

  <section class="pred-hero">
    <div class="hero-photo">
      <picture>
        <source srcset="/images/studio/wag-studio-221.webp" type="image/webp" />
        <img src="/images/studio/wag-studio-221.jpg" alt="Two WAG Podcast hosts on the studio set" fetchpriority="high" />
      </picture>
      <div class="hero-scrim"></div>
    </div>
    <div class="container hero-inner">
      <p class="eyebrow"><EqBars size="sm" /> WAG Predicted It</p>
      <h1>The real calls WAG Podcast made <span class="text-accent">on camera.</span></h1>
      <p class="lede">Every so often, the hosts stop and make an actual prediction — out loud, on the record. Here are the real ones, so you can go check for yourself.</p>
    </div>
  </section>

  <section class="pred-intro">
    <div class="container" data-reveal>
      <Breadcrumb items={[{ label: "Home", href: "/" }, { label: "WAG Predicted It", href: "/wag-predicted-it/" }]} />
      <p>We're not scoring these officially — that's the fun part. Watch the real episode, then vote on whether you think they called it.</p>
    </div>
  </section>

  <section class="predictions">
    <div class="container" data-reveal="stagger">
      <div class="predictions-grid">
        {predictions.map((p) => (
          <div class="pred-card">
            <a class="pred-card-link" href={p.url}>
              <div class="pred-thumb">
                <img src={`https://img.youtube.com/vi/${p.videoId}/mqdefault.jpg`} alt={p.title} loading="lazy" />
              </div>
              <div class="pred-body">
                <h2>{p.title}</h2>
                <p>{p.blurb}</p>
                <span class="pred-link">Watch the episode →</span>
              </div>
            </a>
            <div class="pred-poll">
              <PollWidget pollKey={p.pollKey} question="What do you think?" options={pollOptions} initialCounts={pollCounts[p.pollKey]} />
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="pred-sponsor">
    <div class="container container--narrow" data-reveal>
      <SponsorSlot
        fallbackHref="/watch/"
        fallbackLabel="🎬 Catch up on the latest WAG Podcast episode"
      />
    </div>
  </section>

  <WhatsNext
    items={[
      { icon: "🎭", label: "Which WAG host are you? (WAG Match)", href: "/match/" },
      { icon: "❓", label: "Submit a question", href: "/questions-featured/" },
      { icon: "🎬", label: "Watch every episode", href: "/watch/" },
    ]}
    shareUrl="https://thewagpodcast.com/wag-predicted-it/"
    shareTitle="WAG Predicted It — WAG Podcast"
    insiderPage="wag-predicted-it"
  />
</BaseLayout>

<style>
  .pred-hero{ position:relative; padding: 0 0 32px; }
  .hero-photo{ position:relative; width:100%; aspect-ratio: 2.6/1; overflow:hidden; margin-bottom:40px; }
  .hero-photo img{ width:100%; height:100%; object-fit:cover; object-position: center 40%; display:block; }
  .hero-scrim{ position:absolute; inset:0; background: linear-gradient(0deg, rgba(10,10,15,.8) 0%, transparent 50%); }
  .hero-inner{ max-width:68ch; }
  .eyebrow{ display:inline-flex; align-items:center; gap:10px; color: var(--wag-green); }
  .pred-hero h1{ font-size: clamp(2rem, 4.2vw, 3.1rem); max-width:22ch; }
  .text-accent{
    background: linear-gradient(90deg, var(--wag-pink) 0%, var(--wag-green) 100%);
    -webkit-background-clip:text; background-clip:text; color:transparent;
  }
  .lede{ font-size:1.1rem; max-width:62ch; }

  .pred-intro{ padding: 0 0 32px; }
  .pred-intro p{ font-size:1.02rem; max-width:64ch; }

  .predictions{ padding: 0 0 24px; }
  .predictions-grid{ display:flex; flex-direction:column; gap:32px; max-width:680px; margin:0 auto; }
  .pred-card{ border-radius: var(--radius-lg); overflow:hidden; border:1px solid var(--line); background: var(--bg-alt); }
  .pred-card-link{
    display:grid; grid-template-columns:160px 1fr; gap:0; text-decoration:none; color:inherit;
    transition: background .2s ease;
  }
  .pred-card-link:hover{ background: rgba(255,22,200,.06); }
  .pred-thumb{ aspect-ratio: 16/9; overflow:hidden; }
  .pred-thumb img{ width:100%; height:100%; object-fit:cover; display:block; }
  .pred-body{ padding:16px 20px; }
  .pred-body h2{
    font-family: var(--font-body); font-weight:700; text-transform:none; letter-spacing:0;
    font-size:1.05rem; margin-bottom:.5em; line-height:1.35;
  }
  .pred-body p{ font-size:.9rem; color: var(--ink-soft); margin-bottom:1em; }
  .pred-link{ font-weight:600; font-size:.86rem; color: var(--wag-green); }
  .pred-poll{ border-top:1px solid var(--line); }
  .pred-poll :global(.poll-widget){ border:none; border-radius:0; }

  .container--narrow{ max-width:680px; }
  .pred-sponsor{ padding: 8px 0 32px; }

  @media (max-width: 600px){
    .pred-card-link{ grid-template-columns:1fr; }
  }
</style>
