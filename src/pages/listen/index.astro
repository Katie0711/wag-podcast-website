---
import BaseLayout from "../../layouts/BaseLayout.astro";
import EqBars from "../../components/EqBars.astro";
import { insiderHref } from "../../lib/insiderLink";

const platforms = [
  { name: "Spotify", href: "https://open.spotify.com/show/3tl7szlcJ5eFDqS7cbw6Kb", note: "Full episodes, audio-only, new one every week." },
  { name: "Apple Podcasts", href: "https://podcasts.apple.com/us/podcast/wag-podcast/id1856707489", note: "Same weekly episodes, audio-only." },
  { name: "YouTube", href: "https://www.youtube.com/@WAGPodcast", note: "The original video-first version, if audio ever leaves you wanting the reactions too." },
];
---

<BaseLayout
  title="Listen — WAG Podcast"
  description="Where to listen to WAG Podcast: Spotify and Apple Podcasts for audio-only episodes, released weekly."
  ogImage="/images/studio/wag-studio-333.jpg"
>
  <section class="listen-hero">
    <div class="hero-photo">
      <picture>
        <source srcset="/images/studio/wag-studio-333.webp" type="image/webp" />
        <img src="/images/studio/wag-studio-333.jpg" alt="Annabella and Scarlett reacting on the WAG Podcast set" fetchpriority="high" />
      </picture>
      <div class="hero-scrim"></div>
    </div>
    <div class="container hero-inner">
      <p class="eyebrow"><EqBars size="sm" /> Listen</p>
      <h1>Prefer <span class="text-accent">audio</span>? It's here too.</h1>
      <p class="lede">WAG Podcast is filmed for video first, but every episode also goes up as audio-only on Spotify and Apple Podcasts — same conversation, no screen required.</p>
    </div>
  </section>

  <section class="platforms">
    <div class="container" data-reveal="stagger">
      {platforms.map((p) => (
        <a class="platform-card" href={p.href} target="_blank" rel="noopener">
          <h2>{p.name}</h2>
          <p>{p.note}</p>
          <span class="platform-cta">Open {p.name} →</span>
        </a>
      ))}
    </div>
  </section>

  <section class="spotify-embed">
    <div class="container" data-reveal>
      <iframe
        src="https://open.spotify.com/embed/show/3tl7szlcJ5eFDqS7cbw6Kb"
        title="WAG Podcast on Spotify"
        width="100%"
        height="232"
        loading="lazy"
        allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
      ></iframe>
    </div>
  </section>

  <section class="join">
    <div class="container register-light join-inner" data-reveal>
      <h2>Never miss a new episode.</h2>
      <p>Join WAG Insider for new-episode alerts and behind-the-scenes extras — the same free list the main WAG site uses, one signup for everything WAG.</p>
      <a class="btn btn-primary" href={insiderHref("listen")}>Join WAG Insider →</a>
    </div>
  </section>
</BaseLayout>

<style>
  .listen-hero{ position:relative; padding: 0 0 32px; }
  .hero-photo{ position:relative; width:100%; aspect-ratio: 2.6/1; overflow:hidden; margin-bottom:40px; }
  .hero-photo img{ width:100%; height:100%; object-fit:cover; object-position: center 20%; display:block; }
  .hero-scrim{ position:absolute; inset:0; background: linear-gradient(0deg, rgba(10,10,15,.8) 0%, transparent 50%); }
  .hero-inner{ max-width:68ch; }
  .eyebrow{ display:inline-flex; align-items:center; gap:10px; }
  .listen-hero h1{ font-size: clamp(2rem, 4.2vw, 3.1rem); max-width:20ch; }
  .text-accent{
    background: linear-gradient(90deg, var(--wag-pink) 0%, var(--wag-green) 100%);
    -webkit-background-clip:text; background-clip:text; color:transparent;
  }
  .lede{ font-size:1.1rem; max-width:60ch; }

  .platforms{ padding: 48px 0 24px; }
  .platforms .container{ display:grid; grid-template-columns: repeat(3, 1fr); gap:20px; }
  .platform-card{
    display:block; padding:24px 26px; border-radius: var(--radius); border:1px solid var(--line);
    background: var(--bg-alt); transition: transform .2s ease, box-shadow .2s ease, border-color .2s ease;
  }
  .platform-card:hover{ transform: translateY(-3px); box-shadow: 0 16px 36px rgba(165,235,14,.16); border-color: var(--wag-green); }
  .platform-card h2{ font-size:1.2rem; margin-bottom:.4em; }
  .platform-card p{ font-size:.9rem; margin-bottom:1em; }
  .platform-cta{ font-weight:600; font-size:.88rem; color: var(--wag-green); }

  .spotify-embed{ padding: 24px 0 8px; }
  .spotify-embed iframe{ border-radius: var(--radius); border:1px solid var(--line); display:block; }

  .join{ padding: 8px 0 72px; }
  .join-inner{
    padding:44px 40px; border-radius: var(--radius-lg); text-align:center;
    display:flex; flex-direction:column; align-items:center; gap:14px;
    position:relative;
    background:
      linear-gradient(var(--bg), var(--bg)) padding-box,
      linear-gradient(120deg, var(--wag-pink), var(--wag-green)) border-box;
    border: 2px solid transparent;
  }
  .join-inner h2{ font-size: clamp(1.4rem, 2.8vw, 2rem); margin:0; }
  .join-inner p{ max-width:52ch; margin:0; }

  @media (max-width: 760px){
    .platforms .container{ grid-template-columns:1fr; }
  }
</style>
